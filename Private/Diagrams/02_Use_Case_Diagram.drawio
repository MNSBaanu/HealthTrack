<mxfile host="app.diagrams.net">
  <diagram id="usecase" name="Use Case Diagram">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="boundary" value="HealthTrack System" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="560" height="640" as="geometry" /></mxCell>

        <!-- Actors -->
        <mxCell id="aClient" value="Client" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="30" height="60" as="geometry" /></mxCell>
        <mxCell id="aTrainer" value="Trainer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="140" width="30" height="60" as="geometry" /></mxCell>
        <mxCell id="aAdmin" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="430" width="30" height="60" as="geometry" /></mxCell>
        <mxCell id="aUser" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=3;" vertex="1" parent="1"><mxGeometry x="465" y="700" width="30" height="60" as="geometry" /></mxCell>

        <!-- Client use cases -->
        <mxCell id="c1" value="Register" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="c2" value="Log Workouts &amp;amp; Meals" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="130" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="c3" value="Record Health Metrics" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="200" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="c4" value="View Progress" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="270" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="c5" value="Book Appointment" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="340" width="180" height="50" as="geometry" /></mxCell>

        <!-- Trainer use cases -->
        <mxCell id="t1" value="Create Workout / Diet Plan" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="60" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="t2" value="Track Client Progress" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="130" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="t3" value="Approve / Cancel Appointment" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="200" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="t4" value="Give Feedback" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="270" width="190" height="50" as="geometry" /></mxCell>

        <!-- Admin use cases -->
        <mxCell id="a1" value="Manage Users" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="a2" value="Assign Trainer to Client" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="550" y="440" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="a3" value="View System Reports" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="550" y="510" width="190" height="50" as="geometry" /></mxCell>

        <!-- Shared use cases -->
        <mxCell id="u1" value="Login / Logout" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="215" y="590" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="u2" value="View Notifications" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="590" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="u3" value="Export Report (PDF / CSV)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="585" y="590" width="165" height="50" as="geometry" /></mxCell>

        <!-- Associations -->
        <mxCell id="ec1" style="endArrow=none;html=1;" edge="1" parent="1" source="aClient" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec2" style="endArrow=none;html=1;" edge="1" parent="1" source="aClient" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec3" style="endArrow=none;html=1;" edge="1" parent="1" source="aClient" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec4" style="endArrow=none;html=1;" edge="1" parent="1" source="aClient" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec5" style="endArrow=none;html=1;" edge="1" parent="1" source="aClient" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et1" style="endArrow=none;html=1;" edge="1" parent="1" source="aTrainer" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et2" style="endArrow=none;html=1;" edge="1" parent="1" source="aTrainer" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et3" style="endArrow=none;html=1;" edge="1" parent="1" source="aTrainer" target="t3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="et4" style="endArrow=none;html=1;" edge="1" parent="1" source="aTrainer" target="t4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea1" style="endArrow=none;html=1;" edge="1" parent="1" source="aAdmin" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" style="endArrow=none;html=1;" edge="1" parent="1" source="aAdmin" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea3" style="endArrow=none;html=1;" edge="1" parent="1" source="aAdmin" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eu1" style="endArrow=none;html=1;" edge="1" parent="1" source="aUser" target="u1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eu2" style="endArrow=none;html=1;" edge="1" parent="1" source="aUser" target="u2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eu3" style="endArrow=none;html=1;" edge="1" parent="1" source="aUser" target="u3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Generalization: Client / Trainer / Admin are Users -->
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aClient" target="aUser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="95" y="730" /></Array></mxGeometry></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aTrainer" target="aUser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="225" /><mxPoint x="800" y="225" /><mxPoint x="800" y="730" /></Array></mxGeometry></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aAdmin" target="aUser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="730" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
