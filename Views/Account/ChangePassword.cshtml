@model ChangePasswordViewModel
@{
    ViewData["FormPage"] = "standard";
    ViewData["Title"] = "Change password";
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">Change password</h1>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <section class="ht-card">
            <div class="ht-card-body">
                <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="ht-flash error" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="ht-form-actions">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Change password</button>
                        <a class="btn btn-line" asp-controller="Home" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
