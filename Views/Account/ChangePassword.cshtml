@model ChangePasswordViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<Person> UserManager
@{
    var required = ViewData["RequiredPasswordChange"] is true;
    var person = await UserManager.GetUserAsync(User);
    ViewData["Title"] = required ? "Change password" : "Account";
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">@(required ? "Change password" : "Account")</h1>
        @if (required) { <p class="ht-lede">Choose a new password before continuing to your account.</p> }
    </div>
</div>

<div class="row g-3">
    @if (!required && person != null)
    {
        <div class="col-lg-6">
            <section class="ht-card h-100">
                <div class="ht-card-head"><h2>Account details</h2></div>
                <div class="ht-card-body">
                    <dl class="row mb-0 g-2">
                        <dt class="col-sm-5 text-muted fw-normal">Name</dt><dd class="col-sm-7 fw-semibold">@person.Name</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Email</dt><dd class="col-sm-7 fw-semibold text-break">@person.Email</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Role</dt><dd class="col-sm-7 fw-semibold">@person.RoleDisplayName</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Member since</dt><dd class="col-sm-7 fw-semibold">@person.CreatedAt.ToString("d MMM yyyy")</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Last sign-in</dt><dd class="col-sm-7 fw-semibold mb-0">@(person.LastLoginAt?.ToString("d MMM yyyy, HH:mm") ?? "Never")</dd>
                    </dl>
                </div>
            </section>
        </div>
    }
    <div class="col-lg-6">
        <section class="ht-card h-100">
            <div class="ht-card-head"><h2>Change password</h2></div>
            <div class="ht-card-body">
                <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="ht-flash error" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="ht-form-actions">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>Change password</button>
                        <a class="btn btn-line" asp-controller="Home" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
