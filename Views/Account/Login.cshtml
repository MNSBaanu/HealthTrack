@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
    ViewData["SplitAuth"] = true;
}

<div class="ht-auth-form">
    <h1>Welcome back.</h1>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="ht-flash error" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@example.com" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Sign in <i class="icon-arrow-right"></i></button>
    </form>

    <div class="ht-auth-switch">
        New to HealthTrack? <a asp-controller="Account" asp-action="Register">Start your journal</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
