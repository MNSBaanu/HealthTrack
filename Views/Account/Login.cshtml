@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="ht-auth-form">
    <h1>Welcome back.</h1>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="ht-flash error" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@example.com" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="position-relative">
                <input asp-for="Password" class="form-control pe-5" autocomplete="current-password" />
                <button type="button" id="togglePassword" class="btn position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent px-3" aria-label="Show password" aria-controls="Password" aria-pressed="false" title="Show password">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Sign in <i class="bi bi-arrow-right"></i></button>
    </form>

    <div class="ht-auth-switch">
        New to HealthTrack? <a asp-controller="Account" asp-action="Register">Start your journal</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('Password');
            const toggle = document.getElementById('togglePassword');
            const icon = toggle.querySelector('i');
            toggle.addEventListener('click', () => {
                const visible = input.type === 'password';
                input.type = visible ? 'text' : 'password';
                const label = visible ? 'Hide password' : 'Show password';
                toggle.setAttribute('aria-label', label);
                toggle.setAttribute('aria-pressed', String(visible));
                toggle.title = label;
                icon.classList.toggle('bi-eye', !visible);
                icon.classList.toggle('bi-eye-slash', visible);
            });
        })();
    </script>
}
