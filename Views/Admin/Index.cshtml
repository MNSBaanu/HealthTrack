@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin console";
    var topSessions = Model.PopularActivities.FirstOrDefault()?.Sessions ?? 0;
    var weeklyLogs = Model.WorkoutLogsThisWeek + Model.MealLogsThisWeek + Model.MetricsThisWeek
        + Model.AppointmentsThisWeek + Model.NotificationsThisWeek + Model.TrainerPlansThisWeek + Model.FeedbackThisWeek;
}

<div class="ht-head">
    <div>
        <div class="ht-overline">Admin console &middot; @DateTime.Now.ToString("dddd d MMMM yyyy")</div>
        <h1 class="ht-title">System overview</h1>
    </div>
</div>

<div class="ht-ledger">
    <div>
        <div class="ht-overline">Total users</div>
        <div class="value">@Model.TotalUsers</div>
    </div>
    <div>
        <div class="ht-overline">Clients</div>
        <div class="value">@Model.TotalClients</div>
    </div>
    <div>
        <div class="ht-overline">Admins</div>
        <div class="value">@Model.TotalAdmins</div>
    </div>
    <div>
        <div class="ht-overline">New this week</div>
        <div class="value">@Model.NewUsersThisWeek</div>
    </div>
    <div>
        <div class="ht-overline">Active this week</div>
        <div class="value">@Model.ActiveUsersThisWeek</div>
    </div>
    <div>
        <div class="ht-overline">Locked</div>
        <div class="value">@Model.LockedUsers</div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <section class="ht-card h-100">
            <div class="ht-card-head">
                <h2>System usage</h2>
                <span class="ht-overline">Last 14 days</span>
            </div>
            <div class="ht-card-body">
                <div class="ht-chart">
                    <canvas id="usageChart" aria-label="System usage chart" role="img"></canvas>
                </div>
            </div>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="ht-card ink ht-hero-tile h-100">
            <span class="ht-overline">Activity this week</span>
            <div class="big">@weeklyLogs</div>
            <ul class="ht-facts mt-0">
                <li><span><i class="icon-zap me-2"></i>Workouts</span><strong>@Model.WorkoutLogsThisWeek</strong></li>
                <li><span><i class="icon-coffee me-2"></i>Meals</span><strong>@Model.MealLogsThisWeek</strong></li>
                <li><span><i class="icon-ruler me-2"></i>Measurements</span><strong>@Model.MetricsThisWeek</strong></li>
                <li><span><i class="icon-calendar-check me-2"></i>Appointments</span><strong>@Model.AppointmentsThisWeek</strong></li>
                <li><span><i class="icon-bell me-2"></i>Notifications</span><strong>@Model.NotificationsThisWeek</strong></li>
                <li><span><i class="icon-clipboard-check me-2"></i>Trainer plans</span><strong>@Model.TrainerPlansThisWeek</strong></li>
                <li><span><i class="icon-message-square-text me-2"></i>Feedback</span><strong>@Model.FeedbackThisWeek</strong></li>
            </ul>
        </section>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <section class="ht-card h-100">
            <div class="ht-card-head">
                <h2>Personal workout activities</h2>
                <a asp-action="Reports">Full report <i class="icon-arrow-right"></i></a>
            </div>
            <div class="ht-card-body">
                @if (Model.PopularActivities.Any())
                {
                    <ol class="ht-bars-list">
                        @foreach (var activity in Model.PopularActivities)
                        {
                            var width = topSessions == 0 ? 0 : activity.Sessions * 100.0 / topSessions;
                            <li>
                                <div class="row-top">
                                    <strong>@activity.Activity</strong>
                                    <span class="text-muted">@activity.Sessions sessions &middot; @(activity.ClientCount == 1 ? "1 client" : $"{activity.ClientCount} clients")</span>
                                </div>
                                <div class="ht-bar"><span style="width: @width.ToString("0.#", CultureInfo.InvariantCulture)%"></span></div>
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <p class="text-muted mb-0">No workouts have been logged yet.</p>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script>
        HealthTrackCharts.usage("@Url.Action("UsageData", "Admin")");
    </script>
}
