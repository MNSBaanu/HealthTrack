@model List<LoginHistory>
@{ var person = (Person)ViewData["Person"]!; ViewData["Title"] = "Login history"; }
<a class="ht-back" asp-action="Users"><i class="icon-arrow-left"></i>All users</a>
<div class="ht-head"><div><h1 class="ht-title">Login history</h1><p class="ht-lede">@person.Name · @person.Email</p></div></div>
<section class="ht-card">
    <div class="ht-card-body">
    @if (!Model.Any()) { <p class="text-muted mb-0">No sign-in attempts recorded yet.</p> }
    else
    {
        <div class="table-responsive">
            <table class="ht-table">
                <thead><tr><th>Date</th><th>Result</th><th>IP address</th><th>Browser</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.LoggedInAt.ToString("d MMM yyyy, HH:mm")</td>
                        <td><span class="ht-pill">@(item.Succeeded ? "Success" : "Failed")</span></td>
                        <td>@(item.IpAddress ?? "—")</td>
                        <td class="small text-muted">@(string.IsNullOrEmpty(item.UserAgent) ? "—" : item.UserAgent)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    </div>
</section>
