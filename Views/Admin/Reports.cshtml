@model List<ClientPerformanceViewModel>
@{
    ViewData["Title"] = "Reports";
    var activities = ViewData["PopularActivities"] as List<ActivityStatViewModel> ?? new List<ActivityStatViewModel>();
    var planExercises = ViewData["PlanExercises"] as List<PlanExerciseStatViewModel> ?? new List<PlanExerciseStatViewModel>();
    var topPlans = ViewData["TopPlans"] as List<PlanStatViewModel> ?? new List<PlanStatViewModel>();
    var topExerciseCompletions = planExercises.FirstOrDefault()?.Completions ?? 0;
    var topSessions = activities.FirstOrDefault()?.Sessions ?? 0;
    var weekStart = DateTime.Today.AddDays(-6);
    var activeClients = Model.Count(c => c.LastLoginAt >= weekStart);
    var clientsWithWorkouts = Model.Count(c => c.WorkoutCount > 0);
    var from = ViewData["From"] as DateTime?;
    var to = ViewData["To"] as DateTime?;
    var mealLoggers = Model.Count(c => c.MealLogCount > 0);
    var weightLoggers = Model.Count(c => c.WeightLogCount > 0);
    var averageActiveDays = Model.Count == 0 ? 0 : Model.Average(c => c.ActiveDays);
    var averageWorkouts = Model.Count == 0 ? 0 : Model.Average(c => c.WorkoutCount);
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">Client performance</h1>
    </div>
    <div class="ht-head-actions">
        <a class="btn btn-line" asp-action="ExportReport" asp-route-format="csv" asp-route-from="@from" asp-route-to="@to"><i class="bi bi-filetype-csv"></i>Export CSV</a>
        <a class="btn btn-primary" asp-action="ExportReport" asp-route-format="pdf" asp-route-from="@from" asp-route-to="@to"><i class="bi bi-file-earmark-pdf"></i>Export PDF</a>
    </div>
</div>

<form asp-action="Reports" method="get" class="ht-card ht-filter mb-3">
    <label class="form-label mb-0" for="report-from">From</label>
    <input id="report-from" type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" class="form-control" />
    <label class="form-label mb-0" for="report-to">To</label>
    <input id="report-to" type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" class="form-control" />
    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i>Apply</button>
    @if (from.HasValue || to.HasValue)
    {
        <a class="btn btn-line" asp-action="Reports">Clear</a>
    }
</form>

<div class="ht-ledger">
    <div>
        <div class="ht-overline">Clients</div>
        <div class="value">@Model.Count</div>
    </div>
    <div>
        <div class="ht-overline">Active in 7 days</div>
        <div class="value">@activeClients</div>
        <div class="hint">@(Model.Count == 0 ? 0 : activeClients * 100 / Model.Count)% of clients</div>
    </div>
    <div>
        <div class="ht-overline">Have logged a workout</div>
        <div class="value">@clientsWithWorkouts</div>
    </div>
    <div>
        <div class="ht-overline">Avg. workouts</div>
        <div class="value">@averageWorkouts.ToString("0.#")<small>per client</small></div>
    </div>
</div>

<div class="ht-ledger mt-3">
    <div>
        <div class="ht-overline">Logged meals</div>
        <div class="value">@mealLoggers</div>
        <div class="hint">@(Model.Count == 0 ? 0 : mealLoggers * 100 / Model.Count)% of clients</div>
    </div>
    <div>
        <div class="ht-overline">Logged weight</div>
        <div class="value">@weightLoggers</div>
        <div class="hint">@(Model.Count == 0 ? 0 : weightLoggers * 100 / Model.Count)% of clients</div>
    </div>
    <div>
        <div class="ht-overline">Appointments</div>
        <div class="value">@Model.Sum(c => c.AppointmentCount)</div>
    </div>
    <div>
        <div class="ht-overline">Avg. active days</div>
        <div class="value">@averageActiveDays.ToString("0.#")<small>per client</small></div>
    </div>
</div>

<section class="ht-card my-3">
    <div class="ht-card-head">
        <h2>Performance by client</h2>
        <span class="ht-overline">Sorted by name</span>
    </div>
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="ht-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Start</th>
                        <th>Current</th>
                        <th>Change</th>
                        <th>BMI</th>
                        <th>Workouts</th>
                        <th>Burned</th>
                        <th>Meals</th>
                        <th>Weigh-ins</th>
                        <th>Appts</th>
                        <th>Active days</th>
                        <th>Last active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>
                                <div class="ht-member">
                                    <span class="ht-monogram muted">@Person.GetInitials(client.Name)</span>
                                    <div>
                                        <div class="name">@client.Name</div>
                                        <span class="sub">@client.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td class="num">@(client.StartWeightKg?.ToString("0.0") ?? "–")</td>
                            <td class="num">@(client.CurrentWeightKg?.ToString("0.0") ?? "–")</td>
                            <td>
                                @if (client.WeightChangeKg is double change && change != 0)
                                {
                                    <span class="ht-pill @(change < 0 ? "success" : "clay")">@(change < 0 ? "▼" : "▲") @Math.Abs(change).ToString("0.0") kg</span>
                                }
                                else
                                {
                                    <span class="text-muted">–</span>
                                }
                            </td>
                            <td class="num">@(client.CurrentBmi?.ToString("0.0") ?? "–")</td>
                            <td class="num">@client.WorkoutCount <span class="sub">@client.TotalMinutes min</span></td>
                            <td class="num">@client.TotalCaloriesBurned.ToString("N0") <small>kcal</small></td>
                            <td class="num">@client.MealLogCount</td>
                            <td class="num">@client.WeightLogCount</td>
                            <td class="num">@client.AppointmentCount</td>
                            <td class="num">@client.ActiveDays</td>
                            <td class="text-nowrap">@(client.LastLoginAt?.ToString("d MMM yyyy") ?? "Never")</td>
                            <td><a class="btn-icon" asp-action="ClientDetails" asp-route-id="@client.ClientId" title="View client" aria-label="View @client.Name"><i class="bi bi-arrow-right"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ht-card-body text-muted">No clients have registered yet.</div>
    }
</section>

<section class="ht-card">
    <div class="ht-card-head">
        <h2>Popular routines</h2>
        <span class="ht-overline">Top 10 by sessions</span>
    </div>
    <div class="ht-card-body">
        @if (activities.Any())
        {
            <ol class="ht-bars-list">
                @foreach (var activity in activities)
                {
                    var width = topSessions == 0 ? 0 : activity.Sessions * 100.0 / topSessions;
                    <li>
                        <div class="row-top">
                            <strong>@activity.Activity</strong>
                            <span class="text-muted">@activity.Sessions sessions &middot; @activity.TotalMinutes min &middot; @(activity.ClientCount == 1 ? "1 client" : $"{activity.ClientCount} clients")</span>
                        </div>
                        <div class="ht-bar"><span style="width: @width.ToString("0.#", CultureInfo.InvariantCulture)%"></span></div>
                    </li>
                }
            </ol>
        }
        else
        {
            <p class="text-muted mb-0">No workouts have been logged yet.</p>
        }
    </div>
</section>

<section class="ht-card mt-3">
    <div class="ht-card-head">
        <h2>Popular plan exercises</h2>
        <span class="ht-overline">Top 10 by completions</span>
    </div>
    <div class="ht-card-body">
        @if (planExercises.Any())
        {
            <ol class="ht-bars-list">
                @foreach (var exercise in planExercises)
                {
                    var width = topExerciseCompletions == 0 ? 0 : exercise.Completions * 100.0 / topExerciseCompletions;
                    <li>
                        <div class="row-top">
                            <strong>@exercise.Exercise</strong>
                            <span class="text-muted">@exercise.Completions completed &middot; @(exercise.PlanCount == 1 ? "1 plan" : $"{exercise.PlanCount} plans") &middot; @(exercise.ClientCount == 1 ? "1 client" : $"{exercise.ClientCount} clients")</span>
                        </div>
                        <div class="ht-bar"><span style="width: @width.ToString("0.#", CultureInfo.InvariantCulture)%"></span></div>
                    </li>
                }
            </ol>
        }
        else
        {
            <p class="text-muted mb-0">No trainer workout plans have been created yet.</p>
        }
    </div>
</section>

<section class="ht-card mt-3">
    <div class="ht-card-head">
        <h2>Top trainer plans</h2>
        <span class="ht-overline">Top 10 by completions</span>
    </div>
    @if (topPlans.Any())
    {
        <div class="table-responsive">
            <table class="ht-table">
                <thead>
                    <tr>
                        <th>Plan</th>
                        <th>Trainer</th>
                        <th>Client</th>
                        <th>Exercises</th>
                        <th>Completed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in topPlans)
                    {
                        <tr>
                            <td>@plan.Title</td>
                            <td>@plan.Trainer</td>
                            <td>@plan.Client</td>
                            <td class="num">@plan.ItemCount</td>
                            <td class="num">@plan.Completions</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ht-card-body text-muted">No trainer workout plans have been created yet.</div>
    }
</section>
