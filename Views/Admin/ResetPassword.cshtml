@model ResetUserPasswordViewModel
@inject HealthTrack.Models.Data.HealthTrackDbContext SettingsDb
@{ var settings = await SystemSettings.LoadAsync(SettingsDb); ViewData["Title"] = "Reset temporary password"; ViewData["FormPage"] = "standard"; }
<a class="ht-back" asp-action="Users">All users</a>
<div class="ht-head"><div><h1 class="ht-title">Reset temporary password</h1><p class="ht-lede">@ViewData["TargetUserName"] · Expires in @settings.TemporaryPasswordHours hours. A new password is required at sign-in.</p></div></div>
<div class="row"><div class="col-lg-7"><section class="ht-card"><div class="ht-card-body" data-modal-content>
    <form asp-action="ResetPassword" asp-route-id="@ViewData["TargetUserId"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <div class="ht-form-actions"><button type="submit" class="btn btn-primary">Reset password</button><a asp-action="Users" class="btn btn-line">Cancel</a></div>
    </form>
</div></section></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
