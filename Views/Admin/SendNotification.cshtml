@inject HealthTrack.Services.AppointmentTime FutureDateTime
@inject TimeProvider FutureClock
@model SendNotificationViewModel
@{
    ViewData["FormPage"] = "standard";
    ViewData["Title"] = "Broadcast";
    var recipients = ViewData["Recipients"] as List<SelectListItem> ?? new List<SelectListItem>();
    var history = ViewData["History"] as List<BroadcastHistoryItem> ?? new List<BroadcastHistoryItem>();
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">Send a notification</h1>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8 col-xl-7">
        <section class="ht-card">
            <div class="ht-card-body">
                <form asp-action="SendNotification" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="ht-flash error" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="RecipientId" class="form-label"></label>
                            <select asp-for="RecipientId" asp-items="recipients" class="form-select">
                                <option value="">Everyone &middot; all clients (@recipients.Count(r => r.Group?.Name == "Clients"))</option>
                                <option value="all-trainers">Everyone &middot; all trainers (@recipients.Count(r => r.Group?.Name == "Trainers"))</option>
                            </select>
                            <span asp-validation-for="RecipientId" class="text-danger"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Type" class="form-label"></label>
                            <select asp-for="Type" asp-items="Html.GetEnumSelectList<NotificationType>()" class="form-select"></select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="4" maxlength="300" placeholder="e.g. The gym will be closed this Sunday for maintenance." data-counter="messageCounter"></textarea>
                            <div class="d-flex justify-content-between">
                                <span asp-validation-for="Message" class="text-danger"></span>
                                <span class="form-text ms-auto" id="messageCounter">@(Model.Message?.Length ?? 0) / 300</span>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="ScheduledFor" class="form-label">Deliver at <span class="text-lowercase fw-normal">(optional)</span></label>
                            <input asp-for="ScheduledFor" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" data-not-past="true" data-future-zone="@FutureDateTime.Label" min="@(FutureDateTime.ToLocal(FutureClock.GetUtcNow().UtcDateTime).AddMinutes(1).ToString("yyyy-MM-ddTHH:mm"))" />
                            <div class="form-text">Leave empty to send it straight away.</div>
                            <span asp-validation-for="ScheduledFor" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="ht-form-actions">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i>Send notification</button>
                        <a class="btn btn-line" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

<section class="ht-card mt-3">
    <div class="ht-card-head"><h2>Sent history</h2></div>
    @if (!history.Any())
    {
        <div class="ht-card-body text-muted">No notifications have been sent yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="ht-table">
                <thead><tr><th scope="col">Sent</th><th scope="col">Type</th><th scope="col">Message</th><th scope="col">Recipients</th></tr></thead>
                <tbody>
                    @foreach (var item in history)
                    {
                        <tr>
                            <td>@item.SentAt.ToString("d MMM yyyy, HH:mm")@if (item.ScheduledFor.HasValue) { <div class="small text-muted">Scheduled @item.ScheduledFor.Value.ToString("d MMM yyyy, HH:mm")</div> }</td>
                            <td>@item.Type</td>
                            <td>@item.Message</td>
                            <td>@(item.RecipientName ?? $"{item.Recipients} recipients")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
