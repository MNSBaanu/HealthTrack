@model BookingPageViewModel
@{
    ViewData["FormPage"] = "standard"; ViewData["Title"] = "Book a consultation"; }
<a class="ht-back" asp-action="Index"><i class="icon-arrow-left"></i>My appointments</a>
<div class="ht-head"><div><h1 class="ht-title">Book a consultation</h1><p class="ht-lede">Choose a provider and an available time. Times are shown in @Model.TimeZoneLabel.</p></div></div>
@if (!Model.Providers.Any())
{
    <section class="ht-card"><div class="ht-card-body">No consultation providers are available yet. Please check again later.</div></section>
}
else
{
    <div class="row g-3">
        <div class="col-lg-5">
            <section class="ht-card h-100">
                <div class="ht-card-head"><h2>Providers</h2></div>
                <div class="ht-card-body">
                    <form method="get" asp-action="Book" class="mb-4" data-autofilter>
                        <label class="form-label" for="kind">Provider type</label>
                        <select id="kind" name="kind" class="form-select mb-2">
                            <option value="">All types</option>
                            <option value="@ConsultationProviderKind.Trainer" selected="@(Model.Kind == ConsultationProviderKind.Trainer)">Trainers</option>
                            <option value="@ConsultationProviderKind.HealthcareProfessional" selected="@(Model.Kind == ConsultationProviderKind.HealthcareProfessional)">Healthcare professionals</option>
                        </select>
                        <label class="form-label" for="providerId">Filter by provider</label>
                        <select id="providerId" name="providerId" class="form-select mb-2">
                            <option value="">All providers</option>
                            @foreach (var group in Model.Providers.Where(p => Model.Kind == null || p.Kind == Model.Kind).GroupBy(p => p.Kind))
                            {
                                <optgroup label="@(group.Key == ConsultationProviderKind.Trainer ? "Trainers" : "Healthcare professionals")">
                                    @foreach (var provider in group)
                                    {
                                        <option value="@provider.Id" selected="@(Model.ProviderId == provider.Id)">@provider.Name@(string.IsNullOrWhiteSpace(provider.Specialty) ? "" : $" – {provider.Specialty}")</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </form>
                    <div class="overflow-auto" style="max-height: 16rem">
                    @foreach (var provider in Model.Providers.Where(p => (Model.ProviderId == null || p.Id == Model.ProviderId) && (Model.Kind == null || p.Kind == Model.Kind)))
                    {
                        <div class="mb-3">
                            <strong>@provider.Name</strong>
                            <div class="text-muted">@(provider.Kind == ConsultationProviderKind.Trainer ? "Trainer" : "Healthcare professional")</div>
                            @if (!string.IsNullOrWhiteSpace(provider.Specialty)) { <div>@provider.Specialty</div> }
                        </div>
                    }
                    </div>
                </div>
            </section>
        </div>
        <div class="col-lg-7">
            <section class="ht-card"><div class="ht-card-body">
                <form asp-action="Book" method="post">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    @if (Model.Slots.Any())
                    {
                        <div class="mb-3">
                            <label asp-for="SlotId" class="form-label"></label>
                            <select asp-for="SlotId" class="form-select">
                                <option value="">Choose an available time</option>
                                @foreach (var slot in Model.Slots)
                                {
                                    <option value="@slot.Id">@slot.ProviderName — @slot.Start.ToString("ddd, d MMM yyyy HH:mm")–@slot.End.ToString("HH:mm")</option>
                                }
                            </select>
                            <span asp-validation-for="SlotId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="4" maxlength="2000"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                        <p class="text-muted">Your request will be pending until the provider approves it.</p>
                        <div class="ht-form-actions"><button type="submit" class="btn btn-primary">Request consultation</button><a class="btn btn-line" asp-action="Index">Cancel</a></div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No available times match this provider and your existing appointments. Choose another provider or check again later.</p>
                    }
                </form>
            </div></section>
        </div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
