@model AppointmentViewModel
@{
    ViewData["FormPage"] = "standard"; ViewData["Title"] = "Appointment details"; }
<a class="ht-back" asp-action="Index"><i class="icon-arrow-left"></i>My appointments</a>
<div class="ht-head"><div><h1 class="ht-title">Appointment details</h1><p class="ht-lede">Current consultation information.</p></div></div>
<div class="row"><div class="col-lg-8"><section class="ht-card"><div class="ht-card-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Provider</dt><dd class="col-sm-8">@Model.ProviderName (@Model.ProviderKind)</dd>
        @if (!string.IsNullOrWhiteSpace(Model.Specialty)) { <dt class="col-sm-4">Specialty</dt><dd class="col-sm-8">@Model.Specialty</dd> }
        <dt class="col-sm-4">Starts</dt><dd class="col-sm-8">@Model.Start.ToString("dddd, d MMM yyyy HH:mm")</dd>
        <dt class="col-sm-4">Ends</dt><dd class="col-sm-8">@Model.End.ToString("dddd, d MMM yyyy HH:mm")</dd>
        <dt class="col-sm-4">Timezone</dt><dd class="col-sm-8">@ViewData["TimeZoneLabel"]</dd>
        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">
            @if (Model.Status == AppointmentStatus.Pending)
            {
                <span class="ht-pill info">Pending Approval</span>
            }
            else if (Model.Status == AppointmentStatus.Approved)
            {
                <span class="ht-pill success">Approved</span>
            }
            else if (Model.Status == AppointmentStatus.Cancelled)
            {
                <span class="ht-pill danger">Cancelled</span>
            }
            else
            {
                <span class="ht-pill">@Model.Status</span>
            }
        </dd>
        <dt class="col-sm-4">Your notes</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes provided." : Model.Notes)</dd>
        @if (Model.RescheduleStatus != null)
        {
            <dt class="col-sm-4">Reschedule request</dt>
            <dd class="col-sm-8">
                @switch (Model.RescheduleStatus)
                {
                    case RescheduleRequestStatus.Pending:
                        <span class="ht-pill info">Waiting for your trainer</span>
                        break;
                    case RescheduleRequestStatus.Accepted:
                        <span class="ht-pill success">Accepted &middot; choose a new time</span>
                        break;
                    case RescheduleRequestStatus.Declined:
                        <span class="ht-pill danger">Declined</span>
                        break;
                    case RescheduleRequestStatus.Used:
                        <span class="ht-pill">Rescheduled</span>
                        break;
                    default:
                        <span class="ht-pill">Closed</span>
                        break;
                }
                <div class="small text-muted mt-1">Your reason: @Model.RescheduleReason</div>
                @if (!string.IsNullOrWhiteSpace(Model.RescheduleTrainerNote))
                {
                    <div class="small mt-1">Trainer's note: @Model.RescheduleTrainerNote</div>
                }
            </dd>
        }
    </dl>
</div>
@if (Model.Status == AppointmentStatus.Approved && (Model.CanReschedule || Model.CanRequestReschedule))
{
    <div class="ht-card-footer p-3 border-top">
        <div class="d-flex gap-2">
            @if (Model.CanReschedule)
            {
                <a asp-action="Reschedule" asp-route-appointmentId="@Model.Id" class="btn btn-primary">
                    <i class="icon-calendar-days me-1"></i>Choose a new time
                </a>
            }
            else
            {
                <a asp-action="RequestReschedule" asp-route-appointmentId="@Model.Id" class="btn btn-line">
                    <i class="icon-refresh-cw me-1"></i>Request to reschedule
                </a>
            }
        </div>
    </div>
}
@if (Model.Status == AppointmentStatus.Pending && Model.IsUpcoming)
{
    <div class="ht-card-footer p-3 border-top">
        <div class="d-flex gap-2">
            <a asp-action="Reschedule" asp-route-appointmentId="@Model.Id" class="btn btn-primary">
                <i class="icon-calendar-days me-1"></i>Reschedule
            </a>
            <form asp-action="Cancel" method="post" asp-route-appointmentId="@Model.Id" class="d-inline" data-confirm="Cancel this appointment request?">
                <button type="submit" class="btn btn-line-danger">
                    <i class="icon-x me-1"></i>Cancel request
                </button>
            </form>
        </div>
    </div>
}
@if (Model.Status == AppointmentStatus.Approved && Model.IsUpcoming)
{
    <div class="ht-card-footer p-3 border-top">
        <form asp-action="RequestChange" asp-route-id="@Model.Id" method="post">
            <p class="text-muted small">This appointment is approved. Send a request to your trainer to cancel or reschedule it.</p>
            <div class="mb-3">
                <label class="form-label" for="requestType">Request</label>
                <select class="form-select" id="requestType" name="requestType">
                    <option value="Reschedule">Reschedule</option>
                    <option value="Cancel">Cancel</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="message">Message (optional)</label>
                <textarea class="form-control" id="message" name="message" rows="3" maxlength="500"></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="icon-send me-1"></i>Send request</button>
        </form>
    </div>
}
@if (ViewData["Rating"] is int givenRating)
{
    <div class="ht-card-footer p-3 border-top">
        <h2 class="h6">Your rating</h2>
        <p class="mb-1" aria-label="@givenRating out of 5">
            @for (var star = 1; star <= 5; star++) { <i class="@(star <= givenRating ? "icon-star" : "icon-star opacity-25") text-warning"></i> }
        </p>
        @if (!string.IsNullOrWhiteSpace(ViewData["RatingComment"] as string)) { <p class="small text-muted mb-0">@ViewData["RatingComment"]</p> }
    </div>
}
else if (ViewData["CanRate"] is true)
{
    <div class="ht-card-footer p-3 border-top">
        <form asp-action="Rate" asp-route-id="@Model.Id" method="post">
            <h2 class="h6">How was this consultation?</h2>
            <div class="mb-3">
                <label class="form-label" for="rating">Rating</label>
                <select class="form-select" id="rating" name="rating" required>
                    <option value="">Choose…</option>
                    <option value="5">5 – Excellent</option>
                    <option value="4">4 – Good</option>
                    <option value="3">3 – Okay</option>
                    <option value="2">2 – Poor</option>
                    <option value="1">1 – Very poor</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="ratingComment">Comment (optional)</label>
                <textarea class="form-control" id="ratingComment" name="comment" rows="2" maxlength="500"></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="icon-star me-1"></i>Submit rating</button>
        </form>
    </div>
}
</section></div></div>
