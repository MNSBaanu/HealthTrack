@model AppointmentViewModel
@{
    ViewData["FormPage"] = "standard"; ViewData["Title"] = "Appointment details"; }
<a class="ht-back" asp-action="Index"><i class="bi bi-arrow-left"></i>My appointments</a>
<div class="ht-head"><div><h1 class="ht-title">Appointment details</h1><p class="ht-lede">Current consultation information.</p></div></div>
<div class="row"><div class="col-lg-8"><section class="ht-card"><div class="ht-card-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Provider</dt><dd class="col-sm-8">@Model.ProviderName (@Model.ProviderKind)</dd>
        @if (!string.IsNullOrWhiteSpace(Model.Specialty)) { <dt class="col-sm-4">Specialty</dt><dd class="col-sm-8">@Model.Specialty</dd> }
        <dt class="col-sm-4">Starts</dt><dd class="col-sm-8">@Model.Start.ToString("dddd, d MMM yyyy HH:mm")</dd>
        <dt class="col-sm-4">Ends</dt><dd class="col-sm-8">@Model.End.ToString("dddd, d MMM yyyy HH:mm")</dd>
        <dt class="col-sm-4">Timezone</dt><dd class="col-sm-8">@ViewData["TimeZoneLabel"]</dd>
        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd>
        <dt class="col-sm-4">Your notes</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes provided." : Model.Notes)</dd>
    </dl>
    @if (Model.Status == AppointmentStatus.Pending)
    {
        <div class="ht-form-actions mt-3">
            <a class="btn btn-primary" asp-action="Reschedule" asp-route-id="@Model.Id"><i class="bi bi-calendar-event me-1"></i>Reschedule</a>
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirm="Cancel this appointment?">
                <button type="submit" class="btn btn-line">Cancel appointment</button>
            </form>
        </div>
    }
    else if (Model.Status == AppointmentStatus.Approved)
    {
        <hr />
        <form asp-action="RequestChange" asp-route-id="@Model.Id" method="post">
            <p class="text-muted small">This appointment is approved. Send a request to your trainer to cancel or reschedule it.</p>
            <div class="mb-3">
                <label class="form-label" for="requestType">Request</label>
                <select class="form-select" id="requestType" name="requestType">
                    <option value="Reschedule">Reschedule</option>
                    <option value="Cancel">Cancel</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="message">Message (optional)</label>
                <textarea class="form-control" id="message" name="message" rows="3" maxlength="500"></textarea>
            </div>
            <div class="ht-form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Send request</button>
            </div>
        </form>
    }
    @if (ViewData["Rating"] is int givenRating)
    {
        <hr />
        <h2 class="h6">Your rating</h2>
        <p class="mb-1" aria-label="@givenRating out of 5">
            @for (var star = 1; star <= 5; star++) { <i class="bi @(star <= givenRating ? "bi-star-fill" : "bi-star") text-warning"></i> }
        </p>
        @if (!string.IsNullOrWhiteSpace(ViewData["RatingComment"] as string)) { <p class="small text-muted mb-0">@ViewData["RatingComment"]</p> }
    }
    else if (ViewData["CanRate"] is true)
    {
        <hr />
        <form asp-action="Rate" asp-route-id="@Model.Id" method="post">
            <h2 class="h6">How was this consultation?</h2>
            <div class="mb-3">
                <label class="form-label" for="rating">Rating</label>
                <select class="form-select" id="rating" name="rating" required>
                    <option value="">Choose…</option>
                    <option value="5">5 – Excellent</option>
                    <option value="4">4 – Good</option>
                    <option value="3">3 – Okay</option>
                    <option value="2">2 – Poor</option>
                    <option value="1">1 – Very poor</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="ratingComment">Comment (optional)</label>
                <textarea class="form-control" id="ratingComment" name="comment" rows="2" maxlength="500"></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-star me-1"></i>Submit rating</button>
        </form>
    }
</div></section></div></div>
