@model RescheduleRequestPageViewModel
@{ ViewData["Title"] = "Request to reschedule"; }
<a class="ht-back" asp-action="Details" asp-route-id="@Model.Appointment.Id"><i class="bi bi-arrow-left"></i>Back to appointment</a>
<div class="ht-head"><div><h1 class="ht-title">Request to reschedule</h1><p class="ht-lede">Your trainer must accept this request before you can choose a new time.</p></div></div>
<div class="row"><div class="col-lg-8"><section class="ht-card"><div class="ht-card-body">
    <dl class="row mb-3">
        <dt class="col-sm-4">Trainer</dt><dd class="col-sm-8">@Model.Appointment.ProviderName</dd>
        <dt class="col-sm-4">Current time</dt><dd class="col-sm-8">@Model.Appointment.Start.ToString("dddd, d MMM yyyy HH:mm") (@Model.TimeZoneLabel)</dd>
    </dl>
    <form asp-action="RequestReschedule" asp-route-appointmentId="@Model.Appointment.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <textarea asp-for="Reason" class="form-control" rows="4" maxlength="500"
                      placeholder="e.g. I have a medical appointment at that time and need a later slot."></textarea>
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Send request</button>
            <a asp-action="Details" asp-route-id="@Model.Appointment.Id" class="btn btn-line">Cancel</a>
        </div>
    </form>
</div></section></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
