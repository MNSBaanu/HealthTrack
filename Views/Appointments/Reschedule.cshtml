@model ReschedulePageViewModel
@{
    ViewData["Title"] = "Reschedule appointment";
}

<a class="ht-back" asp-action="Details" asp-route-id="@Model.AppointmentId"><i class="bi bi-arrow-left"></i>Back to appointment</a>

<div class="ht-head">
    <div>
        <h1 class="ht-title">Reschedule your appointment</h1>
        <p class="ht-lede">Choose a new time slot with @Model.ProviderName</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <section class="ht-card">
            <div class="ht-card-head">
                <h2>Current appointment</h2>
            </div>
            <div class="ht-card-body p-3">
                <div class="mb-3">
                    <div class="text-muted small mb-1">Current date & time</div>
                    <strong>@Model.CurrentStartLocal.ToString("dddd, d MMM yyyy")</strong>
                    <div>@Model.CurrentStartLocal.ToString("HH:mm")</div>
                </div>
            </div>
        </section>

        <section class="ht-card mt-3">
            <div class="ht-card-head">
                <h2>Select new time</h2>
            </div>
            <div class="ht-card-body p-0">
                @if (Model.AvailableSlots.Any())
                {
                    <form asp-action="Reschedule" method="post" asp-route-appointmentId="@Model.AppointmentId">
                        <div class="table-responsive">
                            <table class="table ht-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th class="text-center">Select</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slot in Model.AvailableSlots)
                                    {
                                        <tr>
                                            <td><strong>@slot.Start.ToString("ddd, MMM d, yyyy")</strong></td>
                                            <td>@slot.Start.ToString("h:mm tt")</td>
                                            <td class="text-center">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" id="slot_@slot.Id" name="NewSlotId" value="@slot.Id" required />
                                                    <label class="form-check-label" for="slot_@slot.Id"></label>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="p-3 border-top">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-calendar-event me-1"></i>Confirm reschedule
                            </button>
                            <a class="btn btn-line ms-2" asp-action="Details" asp-route-id="@Model.AppointmentId">Cancel</a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="p-4">
                        <p class="text-muted small mb-0">No available slots at this time. Please check back later or contact your trainer.</p>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="ht-card">
            <div class="ht-card-head">
                <h2>Timezone</h2>
            </div>
            <div class="ht-card-body p-3">
                <p class="small text-muted mb-0">All times are shown in <strong>@Model.TimeZoneLabel</strong></p>
            </div>
        </section>
    </div>
</div>

