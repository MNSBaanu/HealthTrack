@model ReschedulePageViewModel
@{
    ViewData["FormPage"] = "standard"; ViewData["Title"] = "Reschedule appointment"; }

<a class="ht-back" asp-action="Details" asp-route-id="@Model.AppointmentId"><i class="bi bi-arrow-left"></i>Back to appointment</a>

<div class="ht-head">
    <div>
        <h1 class="ht-title">Reschedule appointment</h1>
        <p class="ht-lede">Select a new date and time with the same provider. Times are shown in @Model.TimeZoneLabel.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <section class="ht-card h-100">
            <div class="ht-card-head">
                <h2>Current appointment</h2>
            </div>
            <div class="ht-card-body">
                <div class="mb-3">
                    <div class="text-muted small">Provider</div>
                    <strong>@Model.ProviderName</strong>
                </div>
                <div class="mb-0">
                    <div class="text-muted small">Current date & time</div>
                    <strong>@Model.CurrentStartLocal.ToString("ddd, d MMM yyyy")</strong>
                    <div class="text-muted small">@Model.CurrentStartLocal.ToString("h:mm tt")–@Model.CurrentEndLocal.ToString("h:mm tt")</div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-lg-7">
        <section class="ht-card">
            <div class="ht-card-body">
                <form asp-action="Reschedule" asp-route-id="@Model.AppointmentId" method="post">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                    @if (Model.AvailableSlots.Any())
                    {
                        <div class="mb-3">
                            <label asp-for="NewSlotId" class="form-label">Select new appointment time</label>
                            <select asp-for="NewSlotId" class="form-select">
                                <option value="">Choose an available time</option>
                                @foreach (var slot in Model.AvailableSlots)
                                {
                                    <option value="@slot.Id">@slot.Start.ToString("ddd, d MMM yyyy HH:mm")–@slot.End.ToString("HH:mm")</option>
                                }
                            </select>
                            <span asp-validation-for="NewSlotId" class="text-danger"></span>
                        </div>

                        <div class="ht-form-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-calendar-event me-1"></i>Reschedule appointment
                            </button>
                            <a class="btn btn-line" asp-action="Details" asp-route-id="@Model.AppointmentId">Cancel</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No other available times with this provider right now.</p>
                        <div class="ht-form-actions">
                            <a class="btn btn-line" asp-action="Details" asp-route-id="@Model.AppointmentId">Back to appointment</a>
                        </div>
                    }
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
