@model AssignmentEditViewModel
@{
    ViewData["FormPage"] = "standard"; ViewData["Title"] = "Manage Trainer assignment"; }
<a class="ht-back" asp-action="Index"><i class="icon-arrow-left"></i>Trainer assignments</a>
<div class="ht-head"><div><h1 class="ht-title">@Model.ClientName</h1><p class="ht-lede">@Model.ClientEmail</p></div></div>
<div class="row"><div class="col-lg-8"><section class="ht-card"><div class="ht-card-body" data-modal-content>
    <p><strong>Current Trainer:</strong> @(Model.CurrentTrainerName ?? "Unassigned")</p>
    <p class="text-muted">Each Client has one current Trainer. Reassignment or removal preserves existing plans and appointments under their original Trainer.</p>
    <form asp-action="Edit" method="post">
        <input asp-for="ClientId" type="hidden" /><input asp-for="RowVersion" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        @if (Model.Trainers.Any())
        {
            <div class="mb-3"><label asp-for="TrainerId" class="form-label"></label>
                <select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select"><option value="">Select a Trainer</option></select>
                @if (Model.SuggestedTrainerName != null) { <div class="form-text">Least busy: @Model.SuggestedTrainerName</div> }
                <span asp-validation-for="TrainerId" class="text-danger"></span></div>
            <div class="ht-form-actions"><button type="submit" class="btn btn-primary">Save assignment</button><a class="btn btn-line" asp-action="Index">Cancel</a>
                @if (Model.CurrentTrainerName != null) { <button type="submit" form="removeAssignment" class="btn btn-line">Remove assignment</button> }</div>
        }
        else { <p class="text-muted">No unlocked Trainer accounts are available. An eligible Trainer account is needed before assignment.</p> }
    </form>
    @if (Model.CurrentTrainerName != null)
    {
        <form id="removeAssignment" asp-action="Remove" method="post" class="@(Model.Trainers.Any() ? "" : "mt-4")" data-confirm="Remove this Client's current Trainer assignment? Existing plans and appointments will be preserved.">
            <input name="ClientId" type="hidden" value="@Model.ClientId" /><input name="RowVersion" type="hidden" value="@Model.RowVersion" />
            @if (!Model.Trainers.Any()) { <button type="submit" class="btn btn-line">Remove assignment</button> }
        </form>
    }
</div></section></div></div>
<div class="row"><div class="col-lg-8"><section class="ht-card mt-4" data-modal-content><div class="ht-card-head"><h2>Assignment history</h2></div>
    @if (Model.History.Any())
    {
        <div class="table-responsive"><table class="ht-table">
            <thead><tr><th>Trainer</th><th>Assigned</th><th>Ended</th></tr></thead>
            <tbody>
            @foreach (var h in Model.History)
            {
                <tr><td>@(h.Trainer?.Name ?? "Unknown")</td><td>@h.AssignedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@(h.EndedAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "Current")</td></tr>
            }
            </tbody>
        </table></div>
    }
    else { <div class="ht-card-body"><p class="text-muted mb-0">No assignment history yet.</p></div> }
</section></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
