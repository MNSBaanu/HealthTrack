@model ClientDietPlanViewModel
@{ var plan = Model.Plan; ViewData["Title"] = "Diet plan"; }
<div class="ht-head"><div><div class="ht-overline">Assigned diet plan</div><h1 class="ht-title">@plan.Title</h1></div><a class="btn btn-line" asp-action="Index">All assigned plans</a></div>
<section class="ht-card mb-3"><div class="ht-card-body">
    <span class="ht-pill">@ClientPlanStatus.Get(plan.IsActive, plan.StartDate, plan.EndDate, Model.Today)</span>
    <p class="mt-3">Assigned Trainer: <strong>@(plan.Trainer?.Name ?? "Trainer unavailable")</strong></p>
    <p>Active dates: @plan.StartDate.ToString("d MMM yyyy") – @(plan.EndDate?.ToString("d MMM yyyy") ?? "No end date")</p>
    <p>Daily calorie target: <strong>@plan.DailyCalorieTarget.ToString("N0") kcal</strong></p>
    <div class="d-flex flex-wrap gap-3 mb-3">
        @if (plan.TargetProteinGrams.HasValue) { <span>Protein: @plan.TargetProteinGrams g</span> }
        @if (plan.TargetCarbsGrams.HasValue) { <span>Carbohydrates: @plan.TargetCarbsGrams g</span> }
        @if (plan.TargetFatGrams.HasValue) { <span>Fat: @plan.TargetFatGrams g</span> }
    </div>
    @if (!string.IsNullOrWhiteSpace(plan.Description)) { <p style="white-space: pre-line">@plan.Description</p> }
</div></section>
<section class="ht-card"><div class="ht-card-head"><h2>Meals and daily schedule</h2></div><div class="ht-card-body">
    <p class="small text-muted">Meals are organised by meal type. Exact meal times are not specified in this plan.</p>
    @if (!plan.Meals.Any()) { <p class="text-muted">No meal items have been added to this plan yet.</p> }
    @foreach (var meal in plan.Meals.OrderBy(m => m.MealType).ThenBy(m => m.Id))
    {
        <article class="border-bottom py-3">
            <h3 class="h5">@meal.MealType</h3>
            <p style="white-space: pre-line">@meal.FoodRecommendations</p>
            @if (meal.ApproximateCalories.HasValue) { <p class="small">Estimated calories: @meal.ApproximateCalories kcal</p> }
            @if (!string.IsNullOrWhiteSpace(meal.Notes)) { <p class="text-muted mb-0" style="white-space: pre-line">@meal.Notes</p> }
        </article>
    }
</div></section>
<p class="text-muted mt-3">Record what you ate separately in your <a asp-controller="MealLogs" asp-action="Index">meal journal</a>.</p>
