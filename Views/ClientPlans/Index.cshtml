@model ClientPlansViewModel
@{
    ViewData["Title"] = "Assigned plans";
    bool IsPast(bool active, DateTime start, DateTime? end) => ClientPlanStatus.Get(active, start, end, Model.Today) is "Ended" or "Inactive";
    var workoutPlans = Model.WorkoutPlans.OrderBy(p => IsPast(p.IsActive, p.StartDate, p.EndDate)).ToList();
    var dietPlans = Model.DietPlans.OrderBy(p => IsPast(p.IsActive, p.StartDate, p.EndDate)).ToList();
    var pastWorkouts = workoutPlans.Count(p => IsPast(p.IsActive, p.StartDate, p.EndDate));
    var pastDiets = dietPlans.Count(p => IsPast(p.IsActive, p.StartDate, p.EndDate));
    var currentWorkouts = workoutPlans.Count - pastWorkouts;
    var currentDiets = dietPlans.Count - pastDiets;
    var pastStarted = false;
}
<div class="ht-head">
    <div><h1 class="ht-title">Assigned plans</h1></div>
    <div class="ht-head-actions">
        <a class="btn btn-line" asp-controller="ClientFeedback" asp-action="Index"><i class="icon-message-square-text"></i>Trainer feedback</a>
        <a class="btn btn-line" asp-controller="Client" asp-action="Index">Back to overview</a>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-6"><section class="ht-card h-100">
        <div class="ht-card-head"><h2>Workout plans</h2></div>
        <div class="ht-card-body" data-filterable>
        @if (!workoutPlans.Any()) { <p class="text-muted mb-0">No workout plans assigned yet.</p> }
        else if (currentWorkouts == 0) { <p class="text-muted">No current workout plans.</p> }
        else { <div class="ht-overline mb-3">Current plans</div> }
        @{ pastStarted = false; }
        @foreach (var plan in workoutPlans)
        {
            if (IsPast(plan.IsActive, plan.StartDate, plan.EndDate) && !pastStarted)
            {
                pastStarted = true;
                @:<details class="ht-past-plans mt-2"@(currentWorkouts == 0 ? " open" : "")><summary><span><strong>Past plans</strong> <span class="ht-pill ms-1">@pastWorkouts</span><span class="d-block small text-muted">Ended or paused. Select to show or hide.</span></span><i class="icon-chevron-down" aria-hidden="true"></i></summary>
            }
            <article class="border-bottom pb-3 mb-3">
                <h3 class="h5"><a asp-action="Workout" asp-route-id="@plan.Id">@plan.Title</a></h3>
                <span class="ht-pill">@ClientPlanStatus.Get(plan.IsActive, plan.StartDate, plan.EndDate, Model.Today)</span>
                <p class="small text-muted mt-2 mb-1">Trainer: @(plan.Trainer?.Name ?? "Trainer unavailable")</p>
                <p class="small mb-1">@plan.StartDate.ToString("d MMM yyyy") – @(plan.EndDate?.ToString("d MMM yyyy") ?? "No end date")</p>
                @if (!string.IsNullOrWhiteSpace(plan.Goal)) { <p class="mb-0">Goal: @plan.Goal</p> }
            </article>
        }
        @if (pastStarted)
        {
            @:</details>
        }
        </div>
    </section></div>
    <div class="col-lg-6"><section class="ht-card h-100">
        <div class="ht-card-head"><h2>Diet plans</h2></div>
        <div class="ht-card-body" data-filterable>
        @if (!dietPlans.Any()) { <p class="text-muted mb-0">No diet plans assigned yet.</p> }
        else if (currentDiets == 0) { <p class="text-muted">No current diet plans.</p> }
        else { <div class="ht-overline mb-3">Current plans</div> }
        @{ pastStarted = false; }
        @foreach (var plan in dietPlans)
        {
            if (IsPast(plan.IsActive, plan.StartDate, plan.EndDate) && !pastStarted)
            {
                pastStarted = true;
                @:<details class="ht-past-plans mt-2"@(currentDiets == 0 ? " open" : "")><summary><span><strong>Past plans</strong> <span class="ht-pill ms-1">@pastDiets</span><span class="d-block small text-muted">Ended or paused. Select to show or hide.</span></span><i class="icon-chevron-down" aria-hidden="true"></i></summary>
            }
            <article class="border-bottom pb-3 mb-3">
                <h3 class="h5"><a asp-action="Diet" asp-route-id="@plan.Id">@plan.Title</a></h3>
                <span class="ht-pill">@ClientPlanStatus.Get(plan.IsActive, plan.StartDate, plan.EndDate, Model.Today)</span>
                <p class="small text-muted mt-2 mb-1">Trainer: @(plan.Trainer?.Name ?? "Trainer unavailable")</p>
                <p class="small mb-1">@plan.StartDate.ToString("d MMM yyyy") – @(plan.EndDate?.ToString("d MMM yyyy") ?? "No end date")</p>
                <p class="mb-0">Daily target: @plan.DailyCalorieTarget.ToString("N0") kcal</p>
            </article>
        }
        @if (pastStarted)
        {
            @:</details>
        }
        </div>
    </section></div>
</div>
