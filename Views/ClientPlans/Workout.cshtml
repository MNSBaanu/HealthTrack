@model ClientWorkoutPlanViewModel
@{
    var plan = Model.Plan;
    ViewData["Title"] = "Workout plan";
    var total = plan.Items.Count(Model.IsInPlanDates);
    var done = Model.CompletedItemIds.Count;
    var percentage = total == 0 ? 0 : done * 100 / total;
}
<link rel="stylesheet" href="~/css/workout-checklist.css" asp-append-version="true" />
<div class="ht-head"><div><div class="ht-overline">Assigned workout plan</div><h1 class="ht-title">@plan.Title</h1></div><a class="btn btn-line" asp-action="Index">All assigned plans</a></div>
<section class="ht-card mb-3"><div class="ht-card-body">
    <span class="ht-pill">@ClientPlanStatus.Get(plan.IsActive, plan.StartDate, plan.EndDate, Model.Today)</span>
    <p class="mt-3">Assigned Trainer: <strong>@(plan.Trainer?.Name ?? "Trainer unavailable")</strong></p>
    <p>Active dates: @plan.StartDate.ToString("d MMM yyyy") – @(plan.EndDate?.ToString("d MMM yyyy") ?? "No end date")</p>
    @if (!string.IsNullOrWhiteSpace(plan.Goal)) { <p>Goal: @plan.Goal</p> }
    @if (!string.IsNullOrWhiteSpace(plan.Description)) { <p style="white-space: pre-line">@plan.Description</p> }
</div></section>
<section class="ht-card" data-workout-checklist>
    <div class="ht-card-head"><div><h2>Weekly workout checklist</h2><p class="text-muted small mb-0 mt-1">@Model.WeekStart.ToString("d MMM") – @Model.WeekStart.AddDays(6).ToString("d MMM yyyy") · Today: @Model.Today.ToString("dddd, d MMM")</p></div></div>
    <div class="ht-card-body">
        <div class="workout-checklist-summary" aria-live="polite" aria-atomic="true">
            <div class="d-flex justify-content-between flex-wrap gap-2"><strong><span data-completed-count>@done</span> of @total completed</strong><span class="text-muted"><span data-remaining-count>@(total - done)</span> remaining</span></div>
            <progress class="workout-checklist-progress" max="@(Math.Max(total, 1))" value="@done" aria-label="Weekly workout completion">@percentage%</progress>
        </div>
        <p class="small text-muted mt-3">Check off today's exercises as you finish them. Completed tasks stay crossed out for this week. Tasks without a set day are tracked for today.</p>
        <div class="ht-flash error" role="alert" data-checklist-error hidden></div>
        <span class="visually-hidden" role="status" data-checklist-status></span>
        @if (!plan.Items.Any()) { <p class="text-muted">No exercises have been added to this plan yet.</p> }
        @foreach (var group in plan.Items.OrderBy(i => i.DayOfWeek.HasValue ? ((int)i.DayOfWeek.Value + 6) % 7 : 7).ThenBy(i => i.Id).GroupBy(i => i.DayOfWeek))
        {
            var groupDone = group.Count(i => Model.CompletedItemIds.Contains(i.Id));
            var groupTotal = group.Count(Model.IsInPlanDates);
            <section class="workout-checklist-day">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <h3 class="h5 mb-0">@(group.Key?.ToString() ?? "Any day") @if (group.Key == Model.Today.DayOfWeek) { <span class="ht-pill ms-2">Today</span> }</h3>
                    <span class="small text-muted"><span data-day-completed>@groupDone</span> / @groupTotal done</span>
                </div>
                @foreach (var item in group)
                {
                    var completed = Model.CompletedItemIds.Contains(item.Id);
                    var journal = Model.JournalItemIds.Contains(item.Id);
                    var scheduledDate = Model.ScheduledDate(item);
                    var inDates = Model.IsInPlanDates(item);
                    var editable = item.CanCompleteOn(Model.Today) && !journal;
                    var status = completed ? "Completed" : !inDates ? "Outside plan dates"
                        : ClientPlanStatus.Get(plan.IsActive, plan.StartDate, plan.EndDate, Model.Today) != "Active" ? "Plan is not active today"
                        : editable ? "To do today" : scheduledDate < Model.Today ? "Not completed" : $"Scheduled for {item.DayOfWeek}";
                    <article class="workout-checklist-item @(completed ? "is-complete" : "")" data-task data-counted="@(inDates ? "true" : "false")" data-completed="@(completed ? "true" : "false")">
                        <form asp-action="SetWorkoutCompletion" method="post" class="workout-checklist-form">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <input class="workout-task-checkbox" type="checkbox" name="completed" value="true" id="workout-task-@item.Id" checked="@completed" disabled="@(!editable)" aria-describedby="workout-state-@item.Id" />
                            <input type="hidden" name="completed" value="false" />
                            @if (editable) { <noscript><button type="submit" class="btn btn-line btn-sm">Save</button></noscript> }
                        </form>
                        <div class="workout-task-content">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <label class="workout-task-title h6 mb-1" for="workout-task-@item.Id">@item.ExerciseName</label>
                                <span class="workout-task-state small" id="workout-state-@item.Id" data-task-state>@status</span>
                            </div>
                            <div class="d-flex flex-wrap gap-3 small text-muted">
                                <span>@scheduledDate.ToString("d MMM")</span>
                                @if (item.Sets.HasValue) { <span>Sets: @item.Sets</span> }
                                @if (item.Reps.HasValue) { <span>Reps: @item.Reps</span> }
                                @if (item.DurationMinutes.HasValue) { <span>Duration: @item.DurationMinutes min</span> }
                                @if (item.RestSeconds.HasValue) { <span>Rest: @item.RestSeconds sec</span> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Instructions)) { <p class="mt-2 mb-0 small" style="white-space: pre-line">@item.Instructions</p> }
                            @if (journal) { <a class="small" asp-controller="WorkoutLogs" asp-action="Index">Recorded in workout journal</a> }
                        </div>
                    </article>
                }
            </section>
        }
    </div>
</section>
<p class="text-muted mt-3">You can update checkboxes only on the scheduled day while the plan is active. To record duration, calories, or other sessions, use your <a asp-controller="WorkoutLogs" asp-action="Index">workout journal</a>.</p>
@section Scripts {
    <script src="~/js/workout-checklist.js" asp-append-version="true"></script>
}
