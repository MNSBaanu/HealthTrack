@model HealthMetric
@{
    ViewData["FormPage"] = "standard";
    ViewData["Title"] = "Edit measurement";
}

<a class="ht-back" asp-action="Index"><i class="icon-arrow-left"></i>Health metrics</a>
<div class="ht-head">
    <div>
        <h1 class="ht-title">Edit measurement</h1>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8 col-xl-7">
        <section class="ht-card">
            <div class="ht-card-body">
                <form asp-action="Edit" asp-route-id="@Model.MetricId" method="post" novalidate>
                    <partial name="_Form" model="Model" />
                    <div class="ht-form-actions">
                        <button type="submit" class="btn btn-primary"><i class="icon-check"></i>Save changes</button>
                        <a class="btn btn-line" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
