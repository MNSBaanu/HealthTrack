@model List<HealthMetric>
@{
    ViewData["Title"] = "Health metrics";
    var emptyState = new EmptyStateViewModel("icon-ruler", "No measurements yet", "Record your weight to start tracking your BMI over time.");
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">Health metrics</h1>
    </div>
    <div class="ht-head-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="icon-plus"></i>Record health measurements</a>
    </div>
</div>

<partial name="_JournalFilters" model="@((JournalFilterViewModel)ViewData["JournalFilter"]!)" />
@if (Model.Any())
{
    var latest = Model.First();
    <div class="ht-ledger">
        <div>
            <div class="ht-overline">Latest</div>
            <div class="value">@latest.WeightKg.ToString("0.0")<small>kg</small></div>
            <div class="hint">@latest.RecordedAt.ToString("d MMM yyyy")</div>
        </div>
        <div>
            <div class="ht-overline">Latest recorded BMI</div>
            <div class="value">@(latest.Bmi?.ToString("0.0") ?? "–")</div>
            <div class="hint">@latest.BmiCategory</div>
        </div>
        <div>
            <div class="ht-overline">Lowest</div>
            <div class="value">@Model.Min(m => m.WeightKg).ToString("0.0")<small>kg</small></div>
        </div>
        <div>
            <div class="ht-overline">Highest</div>
            <div class="value">@Model.Max(m => m.WeightKg).ToString("0.0")<small>kg</small></div>
        </div>
        <div>
            <div class="ht-overline">Entries</div>
            <div class="value">@Model.Count</div>
        </div>
    </div>

    <section class="ht-card">
        <div class="table-responsive">
            <table class="ht-table client-record-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Weight</th>
                        <th>BMI</th>
                        <th>Category</th>
                        <th>Body fat</th>
                        <th>Heart rate</th>
                        <th>Blood pressure</th>
                        <th>Steps</th>
                        <th>Sleep</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var metric in Model)
                    {
                        <tr>
                            <td data-label="Date">
                                <span class="fw-semibold text-dark">@metric.RecordedAt.ToString("d MMM yyyy")</span>
                                <span class="sub">@metric.RecordedAt.ToString("dddd, HH:mm")</span>
                            </td>
                            <td data-label="Weight" class="num"><span>@metric.WeightKg.ToString("0.0") <small>kg</small></span></td>
                            <td data-label="BMI" class="num">@(metric.Bmi?.ToString("0.0") ?? "–")</td>
                            <td data-label="Category"><partial name="_BmiPill" model="metric.BmiCategory" /></td>
                            <td data-label="Body fat" class="num">@(metric.BodyFatPercent.HasValue ? metric.BodyFatPercent.Value.ToString("0.0") + " %" : "–")</td>
                            <td data-label="Heart rate" class="num">@(metric.RestingHeartRate.HasValue ? metric.RestingHeartRate + " bpm" : "–")</td>
                            <td data-label="Blood pressure" class="num">@(metric.SystolicBp.HasValue && metric.DiastolicBp.HasValue ? $"{metric.SystolicBp}/{metric.DiastolicBp}" : "–")</td>
                            <td data-label="Steps" class="num">@(metric.Steps?.ToString("N0") ?? "–")</td>
                            <td data-label="Sleep" class="num">@(metric.SleepHours.HasValue ? metric.SleepHours.Value.ToString("0.#") + " h" : "–")</td>
                            <td data-label="Actions">
                                <div class="ht-row-actions">
                                    <a class="btn-icon" asp-action="Edit" asp-route-id="@metric.MetricId" title="Edit" aria-label="Edit measurement"><i class="icon-pencil"></i></a>
                                    <a class="btn-icon danger" asp-action="Delete" asp-route-id="@metric.MetricId" title="Delete" aria-label="Delete measurement"><i class="icon-trash-2"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else
{
    <section class="ht-card">
        @if (((JournalFilterViewModel)ViewData["JournalFilter"]!).HasFilters) { <div class="ht-card-body"><p class="mb-0">No measurements match these dates. Adjust the dates or clear the filters.</p></div> }
        else { <partial name="_EmptyState" model="emptyState" /> }
    </section>
}
