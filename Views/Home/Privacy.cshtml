@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">Privacy policy</h1>
    </div>
</div>

<article class="ht-card ht-card-body ht-prose">
    <h2>What we store</h2>
    <p>Your name, email address, date of birth, height, fitness goal, and the health measurements, workouts and meals you record.</p>

    <h2>How it is protected</h2>
    <ul>
        <li>Passwords are never stored in plain text; they are hashed before saving.</li>
        <li>Every page with personal data requires you to be signed in, and you can only see your own records.</li>
        <li>Accounts are locked after repeated failed sign-in attempts.</li>
    </ul>

    <h2>Who can see it</h2>
    <p class="mb-0">Administrators can view account and progress information to manage the service. Your data is never shared outside HealthTrack.</p>
</article>
