@model MealLog
@{
    ViewData["FormPage"] = "standard";
    ViewData["Title"] = "Log meal";
}

<a class="ht-back" asp-action="Index"><i class="icon-arrow-left"></i>Meal diary</a>
<div class="ht-head">
    <div>
        <h1 class="ht-title">Log a meal</h1>
        @if (ViewData["IsRepeat"] is true) { <p class="text-muted">Copied from your previous meal. Adjust the values and save a new entry.</p> }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8 col-xl-7">
        <section class="ht-card">
            <div class="ht-card-body">
                <form asp-action="Create" method="post" novalidate>
                    <input type="hidden" asp-for="DietPlanMealId" />
                    <partial name="_Form" model="Model" />
                    <div class="ht-form-actions">
                        <button type="submit" class="btn btn-primary"><i class="icon-check"></i>Save meal</button>
                        <a class="btn btn-line" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
