@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
    var isTrainer = User.IsInRole("Trainer");
    var isAdmin = User.IsInRole("Admin");
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">Notifications</h1>
        <p class="ht-lede">@(unreadCount == 0 ? "You're all caught up." : $"You have {unreadCount} unread notification{(unreadCount == 1 ? "" : "s")}.")</p>
    </div>
    @if (unreadCount > 0)
    {
        <div class="ht-head-actions">
            <form asp-action="MarkAllAsRead" method="post">
                <button type="submit" class="btn btn-line"><i class="bi bi-check2-all"></i>Mark all as read</button>
            </form>
        </div>
    }
</div>

<section class="ht-card ht-narrow wide">
    @if (Model.Any())
    {
        <ul class="ht-notes">
            @foreach (var note in Model)
            {
                @* Derive the target URL from the notification type and available IDs *@
                string? linkUrl = null;
                string? linkLabel = null;

                if (note.AppointmentId.HasValue)
                {
                    linkUrl = isTrainer
                        ? Url.Action("Index", "TrainerSchedule")
                        : Url.Action("Details", "Appointments", new { id = note.AppointmentId.Value });
                    linkLabel = isTrainer ? "View schedule" : "View appointment";
                }
                else if (note.Type == NotificationType.Appointment)
                {
                    linkUrl = isTrainer
                        ? Url.Action("Index", "TrainerSchedule")
                        : Url.Action("Index", "Appointments");
                    linkLabel = isTrainer ? "View schedule" : "View appointments";
                }
                else if (note.Type == NotificationType.Workout && !isTrainer && !isAdmin)
                {
                    linkUrl = Url.Action("Index", "WorkoutLogs");
                    linkLabel = "View workout logs";
                }
                else if (note.Type == NotificationType.Meal && !isTrainer && !isAdmin)
                {
                    linkUrl = Url.Action("Index", "MealLogs");
                    linkLabel = "View meal logs";
                }
                else if (note.Type == NotificationType.Workout && isTrainer)
                {
                    linkUrl = Url.Action("WorkoutPlans", "TrainerPlans");
                    linkLabel = "View workout plans";
                }
                else if (note.Type == NotificationType.Meal && isTrainer)
                {
                    linkUrl = Url.Action("DietPlans", "TrainerPlans");
                    linkLabel = "View diet plans";
                }

                <li class="ht-note @(note.IsRead ? "read" : "unread")">
                    <partial name="_NotificationIcon" model="note.Type" />
                    <div class="body">
                        <div class="message">@note.Message</div>
                        @if (linkUrl != null)
                        {
                            <a href="@linkUrl">@linkLabel</a>
                        }
                        <div class="time">@note.Type &middot; @((note.ScheduledFor ?? note.CreatedAt).ToString("dddd d MMM, HH:mm"))</div>
                    </div>
                    <div class="actions">
                        @if (!note.IsRead)
                        {
                            <form asp-action="MarkAsRead" asp-route-id="@note.NotificationId" method="post">
                                <button type="submit" class="btn-icon" title="Mark as read" aria-label="Mark as read"><i class="bi bi-check2"></i></button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@note.NotificationId" method="post">
                            <button type="submit" class="btn-icon danger" title="Delete" aria-label="Delete notification"><i class="bi bi-x-lg"></i></button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="ht-empty">
            <span class="ht-glyph success"><i class="bi bi-bell-slash"></i></span>
            <h3>Nothing here yet</h3>
            <p>Reminders about workouts, meals and messages from the HealthTrack team will appear here.</p>
        </div>
    }
</section>
