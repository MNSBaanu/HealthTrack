@model UserMenuViewModel

<div class="dropdown">
    <button class="ht-user" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
        <span class="ht-monogram">@Model.Initials</span>
        <span class="meta d-none d-md-block">
            <span class="name">@Model.Name</span>
            <span class="role">@Model.RoleDisplayName</span>
        </span>
        <i class="bi bi-chevron-down small d-none d-md-inline"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end ht-menu">
        <li class="px-3 pt-2 pb-3">
            <div class="fw-bold text-dark">@Model.Name</div>
            <div class="small text-muted text-truncate">@Model.Email</div>
        </li>
        <li><a class="dropdown-item" asp-controller="@Model.DashboardController" asp-action="Index"><i class="bi bi-grid-1x2 me-2"></i>Dashboard</a></li>
        @if (User.IsInRole(AppRoles.Client))
        {
            <li><a class="dropdown-item" asp-controller="Client" asp-action="Profile"><i class="bi bi-person me-2"></i>My profile</a></li>
        }
        <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
        <li><hr class="dropdown-divider" /></li>
        <li>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
            </form>
        </li>
    </ul>
</div>
