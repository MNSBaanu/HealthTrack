<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadPartial" />
</head>
<body>
    <div class="ht-auth">

        <main class="ht-auth-main" role="main">
            <a class="ht-wordmark dark" asp-controller="Account" asp-action="Login"><span class="dot"></span>Health<em>Track</em></a>
            <div class="ht-auth-body">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
