@model EmptyStateViewModel

<div class="ht-empty">
    <span class="ht-glyph saffron"><i class="@Model.Icon"></i></span>
    <h3>@Model.Title</h3>
    <p>@Model.Message</p>
    @if (Model.ActionText != null && Model.ActionController != null)
    {
        <a class="btn btn-primary" asp-controller="@Model.ActionController" asp-action="@Model.ActionName"><i class="icon-plus"></i>@Model.ActionText</a>
    }
</div>
