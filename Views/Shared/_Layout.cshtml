<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadPartial" />
</head>
<body>
    @{
        var isSignedIn = User.Identity?.IsAuthenticated == true;
        var isClient = User.IsInRole(AppRoles.Client);
        var isAdmin = User.IsInRole(AppRoles.Admin);
        var isTrainer = User.IsInRole(AppRoles.Trainer);
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        string Tab(string controller, params string[] actions) =>
            currentController == controller && (actions.Length == 0 || Array.IndexOf(actions, currentAction) >= 0) ? "ht-tab active" : "ht-tab";
        string TabGroup(params string[] controllers) =>
            Array.IndexOf(controllers, currentController) >= 0 ? "ht-tab dropdown-toggle active" : "ht-tab dropdown-toggle";
        string GroupItem(string controller) => currentController == controller ? "dropdown-item active" : "dropdown-item";
    }
    <header class="ht-masthead">
        <div class="container-xl ht-masthead-inner">
            <a class="ht-wordmark" asp-controller="Home" asp-action="@(isSignedIn ? "Dashboard" : "Index")"><span class="dot"></span>Health<em>Track</em></a>

            @if (isSignedIn)
            {
                <nav class="ht-tabs" aria-label="Main navigation">
                    @if (isClient)
                    {
                        <a class="@Tab("Client", "Index")" asp-controller="Client" asp-action="Index"><i class="icon-layout-dashboard"></i>Overview</a>
                        <div class="dropdown">
                            <button type="button" class="@TabGroup("WorkoutLogs", "MealLogs", "HealthMetrics")" data-bs-toggle="dropdown" aria-expanded="false"><i class="icon-pen-line"></i>Log</button>
                            <ul class="dropdown-menu">
                                <li><a class="@GroupItem("WorkoutLogs")" asp-controller="WorkoutLogs" asp-action="Index"><i class="icon-zap me-2"></i>Workouts</a></li>
                                <li><a class="@GroupItem("MealLogs")" asp-controller="MealLogs" asp-action="Index"><i class="icon-coffee me-2"></i>Meals</a></li>
                                <li><a class="@GroupItem("HealthMetrics")" asp-controller="HealthMetrics" asp-action="Index"><i class="icon-ruler me-2"></i>Measurements</a></li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button type="button" class="@TabGroup("ClientPlans", "ClientFeedback", "Appointments", "TrainerRequests")" data-bs-toggle="dropdown" aria-expanded="false"><i class="icon-message-square-text"></i>Coaching</button>
                            <ul class="dropdown-menu">
                                <li><a class="@GroupItem("ClientPlans")" asp-controller="ClientPlans" asp-action="Index"><i class="icon-calendar-range me-2"></i>Plans</a></li>
                                <li><a class="@GroupItem("ClientFeedback")" asp-controller="ClientFeedback" asp-action="Index"><i class="icon-message-square-text me-2"></i>Feedback</a></li>
                                <li><a class="@GroupItem("Appointments")" asp-controller="Appointments" asp-action="Index"><i class="icon-calendar-check me-2"></i>Appointments</a></li>
                            </ul>
                        </div>
                        <a class="@Tab("Client", "Progress")" asp-controller="Client" asp-action="Progress"><i class="icon-trending-up"></i>Progress</a>
                    }
                    @if (isTrainer)
                    {
                        <a class="@Tab("Trainer", "Index")" asp-controller="Trainer" asp-action="Index"><i class="icon-layout-dashboard"></i>Overview</a>
                        <a class="@Tab("Trainer", "Clients", "ClientDetails")" asp-controller="Trainer" asp-action="Clients"><i class="icon-users"></i>My Clients</a>
                        <a class="@Tab("TrainerPlans", "WorkoutPlans", "CreateWorkoutPlan", "EditWorkoutPlan")" asp-controller="TrainerPlans" asp-action="WorkoutPlans"><i class="icon-zap"></i>Workout Plans</a>
                        <a class="@Tab("TrainerPlans", "DietPlans", "CreateDietPlan", "EditDietPlan")" asp-controller="TrainerPlans" asp-action="DietPlans"><i class="icon-coffee"></i>Diet Plans</a>
                        <a class="@Tab("TrainerSchedule")" asp-controller="TrainerSchedule" asp-action="Index"><i class="icon-calendar-check"></i>Consultations</a>
                        <a class="@Tab("TrainerReports")" asp-controller="TrainerReports" asp-action="Index"><i class="icon-notebook-text"></i>Reports</a>
                    }
                    @if (isAdmin)
                    {
                        <a class="@Tab("Admin", "Index")" asp-controller="Admin" asp-action="Index"><i class="icon-layout-dashboard"></i>Console</a>
                        <a class="@Tab("Admin", "Users", "ClientDetails", "EditUser", "CreateAdmin", "CreateTrainer", "ImportUsers", "LoginHistory", "Providers", "CreateProvider", "EditProvider", "ProviderSlots", "AddProviderSlot")" asp-controller="Admin" asp-action="Users"><i class="icon-users"></i>Users</a>
                        <a class="@Tab("Assignments")" asp-controller="Assignments" asp-action="Index"><i class="icon-user-check"></i>Assignments</a>
                        <a class="@Tab("Admin", "Appointments")" asp-controller="Admin" asp-action="Appointments"><i class="icon-calendar-check"></i>Appointments</a>
                        <a class="@Tab("Admin", "Reports", "SystemHealth", "Ratings", "AuditLog", "ChatQuestions")" asp-controller="Admin" asp-action="Reports"><i class="icon-notebook-text"></i>Reports</a>
                        <a class="@Tab("Admin", "SendNotification")" asp-controller="Admin" asp-action="SendNotification"><i class="icon-megaphone"></i>Broadcast</a>
                    }
                </nav>
                <div class="ht-mast-actions">
                    @await Component.InvokeAsync("NotificationBell")
                    @await Component.InvokeAsync("UserMenu")
                </div>
            }
            else
            {
                <div class="ht-mast-actions py-3">
                    <a class="btn btn-sm btn-line-light" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-sm btn-accent" asp-controller="Account" asp-action="Register">Get started</a>
                </div>
            }
        </div>
    </header>

    <partial name="_SiteBanner" />
    <main class="ht-page" role="main">
        <div class="container-xl @(ViewData["FormPage"] is string formWidth ? "ht-form-page " + (formWidth == "wide" ? "ht-form-page-wide" : "") : "")">
            @if (TempData["Success"] is string success)
            {
                <div class="ht-flash success alert fade show" role="status">
                    <i class="icon-circle-check"></i><span>@success</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="ht-flash error alert fade show" role="alert">
                    <i class="icon-octagon-alert"></i><span>@error</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="container-xl ht-app-footer">
        <span>&copy; 2026 HealthTrack</span>
        <a asp-controller="Home" asp-action="Privacy">Privacy policy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/password-visibility.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole(AppRoles.Client) || User.IsInRole(AppRoles.Admin)))
    {
        <partial name="_HelpChatbot" />
        <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
        <script src="~/js/chatbot.js" asp-append-version="true"></script>
    }
    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/js/themed-controls.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
