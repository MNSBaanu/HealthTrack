<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_HeadPartial" />
</head>
<body>
    @{
        var isSignedIn = User.Identity?.IsAuthenticated == true;
        var isClient = User.IsInRole(AppRoles.Client);
        var isAdmin = User.IsInRole(AppRoles.Admin);
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        string Tab(string controller, params string[] actions) =>
            currentController == controller && (actions.Length == 0 || Array.IndexOf(actions, currentAction) >= 0) ? "ht-tab active" : "ht-tab";
    }
    <header class="ht-masthead">
        <div class="container-xl ht-masthead-inner">
            <a class="ht-wordmark" asp-controller="Home" asp-action="@(isSignedIn ? "Dashboard" : "Index")"><span class="dot"></span>Health<em>Track</em></a>

            @if (isSignedIn)
            {
                <nav class="ht-tabs" aria-label="Main navigation">
                    @if (isClient)
                    {
                        <a class="@Tab("Client", "Index")" asp-controller="Client" asp-action="Index"><i class="bi bi-grid-1x2"></i>Overview</a>
                        <a class="@Tab("Client", "Progress")" asp-controller="Client" asp-action="Progress"><i class="bi bi-graph-up"></i>Progress</a>
                        <a class="@Tab("HealthMetrics")" asp-controller="HealthMetrics" asp-action="Index"><i class="bi bi-rulers"></i>Metrics</a>
                        <a class="@Tab("WorkoutLogs")" asp-controller="WorkoutLogs" asp-action="Index"><i class="bi bi-lightning-charge"></i>Workouts</a>
                        <a class="@Tab("MealLogs")" asp-controller="MealLogs" asp-action="Index"><i class="bi bi-cup-hot"></i>Meals</a>
                        <a class="@Tab("Appointments")" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i>Appointments</a>
                    }
                    @if (isAdmin)
                    {
                        <a class="@Tab("Admin", "Index")" asp-controller="Admin" asp-action="Index"><i class="bi bi-grid-1x2"></i>Console</a>
                        <a class="@Tab("Admin", "Users", "ClientDetails", "CreateAdmin")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i>Users</a>
                        <a class="@Tab("Admin", "Reports")" asp-controller="Admin" asp-action="Reports"><i class="bi bi-journal-text"></i>Reports</a>
                        <a class="@Tab("Admin", "SendNotification")" asp-controller="Admin" asp-action="SendNotification"><i class="bi bi-megaphone"></i>Broadcast</a>
                    }
                </nav>
                <div class="ht-mast-actions">
                    @await Component.InvokeAsync("NotificationBell")
                    @await Component.InvokeAsync("UserMenu")
                </div>
            }
            else
            {
                <div class="ht-mast-actions py-3">
                    <a class="btn btn-sm btn-line-light" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-sm btn-accent" asp-controller="Account" asp-action="Register">Get started</a>
                </div>
            }
        </div>
    </header>

    <main class="ht-page" role="main">
        <div class="container-xl">
            @if (TempData["Success"] is string success)
            {
                <div class="ht-flash success alert fade show" role="status">
                    <i class="bi bi-check2-circle"></i><span>@success</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="ht-flash error alert fade show" role="alert">
                    <i class="bi bi-exclamation-octagon"></i><span>@error</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="container-xl ht-app-footer">
        <span>&copy; 2026 HealthTrack</span>
        <a asp-controller="Home" asp-action="Privacy">Privacy policy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
