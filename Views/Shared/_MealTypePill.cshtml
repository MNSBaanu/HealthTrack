@model MealType

@{
    var (icon, tone) = Model switch
    {
        MealType.Breakfast => ("icon-sunrise", "saffron"),
        MealType.Lunch => ("icon-sun", "clay"),
        MealType.Dinner => ("icon-moon-star", "slate"),
        _ => ("icon-apple", "success")
    };
}
<span class="ht-pill @tone"><i class="@icon"></i>@Model</span>
