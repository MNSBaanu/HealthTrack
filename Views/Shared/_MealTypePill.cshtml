@model MealType

@{
    var (icon, tone) = Model switch
    {
        MealType.Breakfast => ("bi-sunrise", "saffron"),
        MealType.Lunch => ("bi-sun", "clay"),
        MealType.Dinner => ("bi-moon-stars", "slate"),
        _ => ("bi-apple", "success")
    };
}
<span class="ht-pill @tone"><i class="bi @icon"></i>@Model</span>
