@model NotificationType

@{
    var (icon, tone) = Model switch
    {
        NotificationType.Workout => ("icon-zap", "saffron"),
        NotificationType.Meal => ("icon-coffee", "clay"),
        NotificationType.Appointment => ("icon-calendar-days", "slate"),
        _ => ("icon-bell", "ink")
    };
}
<span class="ht-glyph @tone"><i class="@icon"></i></span>
