@model TrainerDashboardViewModel
@{
    ViewData["Title"] = "Trainer dashboard";
}

<div class="ht-head">
    <div>
        <div class="ht-overline">Trainer workspace &middot; @DateTime.Now.ToString("dddd d MMMM yyyy")</div>
        <h1 class="ht-title">Welcome, @Model.TrainerName</h1>
    </div>
    <div class="ht-head-actions">
        <a class="btn btn-line" asp-controller="TrainerPlans" asp-action="CreateWorkoutPlan"><i class="bi bi-lightning-charge"></i>New workout plan</a>
        <a class="btn btn-line" asp-controller="TrainerPlans" asp-action="CreateDietPlan"><i class="bi bi-cup-hot"></i>New diet plan</a>
        <a class="btn btn-primary" asp-controller="TrainerSchedule" asp-action="Index"><i class="bi bi-calendar-check"></i>Consultations</a>
    </div>
</div>

<div class="ht-ledger">
    <div>
        <div class="ht-overline">Assigned clients</div>
        <div class="value">@Model.TotalAssignedClients</div>
    </div>
    <div>
        <div class="ht-overline">Pending consultations</div>
        <div class="value">@Model.PendingAppointmentsCount</div>
    </div>
    <div>
        <div class="ht-overline">Active workout plans</div>
        <div class="value">@Model.ActiveWorkoutPlansCount</div>
    </div>
    <div>
        <div class="ht-overline">Active diet plans</div>
        <div class="value">@Model.ActiveDietPlansCount</div>
    </div>
</div>

@if (Model.PendingAppointments.Any())
{
    <section class="ht-card mb-4 border-warning">
        <div class="ht-card-head">
            <h2><i class="bi bi-bell saffron me-2"></i>Pending consultation requests</h2>
            <a asp-controller="TrainerSchedule" asp-action="Index">Manage all schedule <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="ht-card-body p-0">
            <div class="table-responsive">
                <table class="table ht-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Requested slot</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.PendingAppointments)
                        {
                            <tr>
                                <td>
                                    <strong>@appt.ClientName</strong>
                                    <div class="text-muted small">@appt.ClientEmail</div>
                                </td>
                                <td>
                                    <div>@appt.StartLocal.ToString("MMM d, yyyy")</div>
                                    <div class="text-muted small">@appt.StartLocal.ToString("h:mm tt") &ndash; @appt.EndLocal.ToString("h:mm tt")</div>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(appt.Notes) ? "-" : appt.Notes)
                                </td>
                                <td class="text-end">
                                    <form asp-controller="TrainerSchedule" asp-action="Approve" method="post" class="d-inline">
                                        <input type="hidden" name="appointmentId" value="@appt.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i>Approve</button>
                                    </form>
                                    <form asp-controller="TrainerSchedule" asp-action="Cancel" method="post" class="d-inline ms-1">
                                        <input type="hidden" name="appointmentId" value="@appt.Id" />
                                        <button type="submit" class="btn btn-sm btn-line-danger"><i class="bi bi-x-lg"></i>Decline</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <section class="ht-card h-100">
            <div class="ht-card-head">
                <h2>My assigned clients</h2>
                <a asp-action="Clients">View all clients <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="ht-card-body p-0">
                @if (Model.AssignedClients.Any())
                {
                    <div class="table-responsive">
                        <table class="table ht-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Goal</th>
                                    <th>Current BMI</th>
                                    <th>Active plans</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var client in Model.AssignedClients.Take(6))
                                {
                                    <tr>
                                        <td>
                                            <a asp-action="ClientDetails" asp-route-id="@client.ClientId" class="fw-semibold">
                                                @client.Name
                                            </a>
                                            <div class="text-muted small">@client.Email</div>
                                        </td>
                                        <td>
                                            <span class="small">@(string.IsNullOrWhiteSpace(client.FitnessGoal) ? "No goal set" : client.FitnessGoal)</span>
                                        </td>
                                        <td>
                                            @if (client.CurrentBmi.HasValue)
                                            {
                                                <partial name="_BmiPill" model="client.BmiCategory ?? string.Empty" />
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No metrics</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="small">@client.ActiveWorkoutPlansCount workouts &middot; @client.ActiveDietPlansCount diets</span>
                                        </td>
                                        <td>
                                            <a asp-action="ClientDetails" asp-route-id="@client.ClientId" class="btn btn-sm btn-line">Inspect</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4">
                        <partial name="_EmptyState" model='new EmptyStateViewModel("bi bi-people", "No clients assigned yet", "The administrator will assign clients to you. Check back soon.")' />
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="ht-card h-100">
            <div class="ht-card-head">
                <h2>Recent client activity</h2>
            </div>
            <div class="ht-card-body p-3">
                @if (Model.RecentActivities.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var act in Model.RecentActivities)
                        {
                            <li class="py-2 border-bottom border-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="small">@act.ClientName</strong>
                                    <span class="text-muted small">@act.Timestamp.ToString("MMM d")</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    @if (act.ActivityType == "Workout")
                                    {
                                        <i class="bi bi-lightning-charge me-1 text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-cup-hot me-1 text-info"></i>
                                    }
                                    @act.Summary
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0">No workout or meal logs recorded recently by your clients.</p>
                }
            </div>
        </section>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <section class="ht-card">
            <div class="ht-card-head">
                <h2>Recent feedback sent</h2>
            </div>
            <div class="ht-card-body p-0">
                @if (Model.RecentFeedbacks.Any())
                {
                    <div class="table-responsive">
                        <table class="table ht-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Sent</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fb in Model.RecentFeedbacks)
                                {
                                    <tr>
                                        <td><strong>@fb.ClientName</strong></td>
                                        <td>@fb.Title</td>
                                        <td><span class="ht-pill info">@fb.Category</span></td>
                                        <td>@fb.CreatedAtUtc.ToString("MMM d, yyyy")</td>
                                        <td>
                                            @if (fb.IsReadByClient)
                                            {
                                                <span class="text-success small"><i class="bi bi-check2-all"></i> Read</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"><i class="bi bi-check2"></i> Sent</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3">
                        <p class="text-muted small mb-0">No feedback notes sent yet. Open any client's details to write feedback and guidance.</p>
                    </div>
                }
            </div>
        </section>
    </div>
</div>
