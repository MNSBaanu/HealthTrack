@model WorkoutPlanListViewModel
@{
    ViewData["Title"] = "Workout plans";
}

<div class="ht-head">
    <div>
        <div class="ht-overline">Trainer workspace</div>
        <h1 class="ht-title">Personalized workout plans</h1>
    </div>
    <div class="ht-head-actions">
        <a class="btn btn-primary" asp-action="CreateWorkoutPlan"><i class="icon-plus"></i>New workout plan</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <section class="ht-card">
            <div class="ht-card-body p-3">
                <form method="get" class="row g-2 align-items-center" data-autofilter>
                    <div class="col-auto">
                        <label class="form-label mb-0 fw-semibold">Filter by client:</label>
                    </div>
                    <div class="col-sm-4">
                        <select name="clientId" class="form-select form-select-sm" asp-for="SelectedClientId" asp-items="Model.AssignedClients">
                            <option value="">All assigned clients</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        @if (!string.IsNullOrEmpty(Model.SelectedClientId))
                        {
                            <a asp-action="WorkoutPlans" class="btn btn-sm btn-link text-muted">Clear</a>
                        }
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <section class="ht-card">
            <div class="ht-card-body p-0">
                @if (Model.Plans.Any())
                {
                    <div class="table-responsive">
                        <table class="table ht-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Plan title</th>
                                    <th>Client</th>
                                    <th>Goal</th>
                                    <th>Duration</th>
                                    <th>Exercises</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var plan in Model.Plans)
                                {
                                    <tr>
                                        <td>
                                            <a asp-action="EditWorkoutPlan" asp-route-id="@plan.Id" class="fw-semibold">
                                                @plan.Title
                                            </a>
                                            <div class="text-muted small">Created @plan.CreatedAtUtc.ToString("MMM d, yyyy")</div>
                                        </td>
                                        <td>
                                            <strong>@plan.Client?.Name</strong>
                                            <div class="text-muted small">@plan.Client?.Email</div>
                                        </td>
                                        <td>
                                            <span class="small">@(string.IsNullOrWhiteSpace(plan.Goal) ? "General Fitness" : plan.Goal)</span>
                                        </td>
                                        <td>
                                            <span class="small">
                                                @plan.StartDate.ToString("MMM d, yyyy") &ndash;
                                                @(plan.EndDate.HasValue ? plan.EndDate.Value.ToString("MMM d, yyyy") : "Ongoing")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@plan.Items.Count exercises</span>
                                        </td>
                                        <td>
                                            @if (plan.IsActive)
                                            {
                                                <span class="ht-pill success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="ht-pill info">Archived</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-1 flex-nowrap">
                                                <a asp-action="EditWorkoutPlan" asp-route-id="@plan.Id" class="btn btn-sm btn-line">
                                                    <i class="icon-pencil me-1"></i>Edit
                                                </a>
                                                <form asp-action="ToggleWorkoutPlan" asp-route-id="@plan.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-line" title="@(plan.IsActive ? "Archive" : "Activate")">
                                                        <i class="@(plan.IsActive ? "icon-archive" : "icon-circle-check")"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteWorkoutPlan" asp-route-id="@plan.Id" method="post" class="d-inline" data-confirm="Are you sure you want to delete this workout plan? This action cannot be undone.">
                                                    <button type="submit" class="btn btn-sm btn-line-danger" title="Delete plan">
                                                        <i class="icon-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4">
                        <partial name="_EmptyState" model='new EmptyStateViewModel("icon-zap", "No workout plans found", "Create personalized exercise schedules for your assigned clients.")' />
                    </div>
                }
            </div>
        </section>
    </div>
</div>
