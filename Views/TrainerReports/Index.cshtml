@model TrainerReportsViewModel
@{
    ViewData["Title"] = "Trainer reports";
}

<div class="ht-head">
    <div>
        <div class="ht-overline">Trainer analytics &middot; Coach @Model.TrainerName</div>
        <h1 class="ht-title">Client performance & engagement reports</h1>
    </div>
    <div class="ht-head-actions">
        <a class="btn btn-line" asp-action="ExportReport" asp-route-format="csv"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV</a>
        <a class="btn btn-primary" asp-action="ExportReport" asp-route-format="pdf"><i class="bi bi-file-earmark-pdf me-1"></i>Export PDF</a>
    </div>
</div>

<div class="ht-ledger">
    <div>
        <div class="ht-overline">Total clients</div>
        <div class="value">@Model.TotalClients</div>
    </div>
    <div>
        <div class="ht-overline">Active this week</div>
        <div class="value">@Model.ActiveClientsPastWeek</div>
    </div>
    <div>
        <div class="ht-overline">Total client workouts</div>
        <div class="value">@Model.TotalWorkoutsLogged</div>
    </div>
    <div>
        <div class="ht-overline">Total client meals</div>
        <div class="value">@Model.TotalMealsLogged</div>
    </div>
    <div>
        <div class="ht-overline">Avg workouts / client</div>
        <div class="value">@Model.AverageWorkoutsPerClient</div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Client Performance Table -->
    <div class="col-lg-8">
        <section class="ht-card h-100">
            <div class="ht-card-head">
                <h2>Assigned clients progress breakdown</h2>
                <span class="ht-overline">Individual tracking</span>
            </div>
            <div class="ht-card-body p-0">
                @if (Model.ClientPerformances.Any())
                {
                    <div class="table-responsive">
                        <table class="table ht-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Start wt</th>
                                    <th>Current wt</th>
                                    <th>Change</th>
                                    <th>BMI</th>
                                    <th>Workouts</th>
                                    <th>Meals</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.ClientPerformances)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Trainer" asp-action="ClientDetails" asp-route-id="@c.ClientId" class="fw-semibold">
                                                @c.Name
                                            </a>
                                            <div class="text-muted small">@c.Email</div>
                                        </td>
                                        <td>@(c.StartWeightKg.HasValue ? $"{c.StartWeightKg.Value:F1} kg" : "-")</td>
                                        <td>@(c.CurrentWeightKg.HasValue ? $"{c.CurrentWeightKg.Value:F1} kg" : "-")</td>
                                        <td>
                                            @if (c.WeightChangeKg.HasValue)
                                            {
                                                <span class="@(c.WeightChangeKg.Value <= 0 ? "text-success" : "text-danger") fw-semibold">
                                                    @(c.WeightChangeKg.Value > 0 ? "+" : "")@c.WeightChangeKg.Value kg
                                                </span>
                                            }
                                            else { <span>-</span> }
                                        </td>
                                        <td>
                                            @if (c.CurrentBmi.HasValue)
                                            {
                                                <partial name="_BmiPill" model="c.BmiCategory ?? string.Empty" />
                                            }
                                            else { <span>-</span> }
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@c.WorkoutCount</span>
                                            <div class="text-muted small">@c.TotalMinutes min</div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@c.MealLogCount</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4">
                        <p class="text-muted small mb-0">No assigned client records found.</p>
                    </div>
                }
            </div>
        </section>
    </div>

    <!-- Popular Routines -->
    <div class="col-lg-4">
        <section class="ht-card h-100">
            <div class="ht-card-head">
                <h2>Popular routines</h2>
                <span class="ht-overline">Your clients</span>
            </div>
            <div class="ht-card-body p-3">
                @if (Model.PopularActivities.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var act in Model.PopularActivities)
                        {
                            <li class="py-2 border-bottom border-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="small">@act.Activity</strong>
                                    <span class="badge bg-light text-dark border">@act.Sessions sessions</span>
                                </div>
                                <div class="text-muted small mt-1">
                                    @act.ClientCount client(s) &middot; @act.TotalMinutes total minutes
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0">No workouts logged yet by your clients.</p>
                }
            </div>
        </section>
    </div>
</div>
