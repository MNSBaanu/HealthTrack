@model WorkoutLog
@{
    ViewData["Title"] = "Delete workout";
}

<a class="ht-back" asp-action="Index"><i class="bi bi-arrow-left"></i>Training journal</a>

<section class="ht-card ht-narrow">
    <div class="ht-card-body ht-confirm">
        <span class="ht-glyph clay xl"><i class="bi bi-trash3"></i></span>
        <h1 class="ht-title sm">Delete this workout?</h1>
        <p class="ht-lede mx-auto">This can't be undone. Your weekly totals and charts will update.</p>

        <div class="ht-entry boxed">
            <partial name="_DateBadge" model="Model.LoggedAt" />
            <div>
                <div class="title">@Model.Activity</div>
                <div class="meta">@Model.LoggedAt.ToString("dddd, HH:mm") &middot; @Model.DurationMinutes min</div>
            </div>
            <div class="figure">@Model.CaloriesBurned.ToString("N0")<small>kcal</small></div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.WorkoutLogId" method="post" class="d-flex justify-content-center gap-2">
            <a class="btn btn-line" asp-action="Index">Keep it</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3"></i>Delete</button>
        </form>
    </div>
</section>
