@model List<WorkoutLog>
@{
    ViewData["Title"] = "Workouts";
    var emptyState = new EmptyStateViewModel("icon-zap", "No workouts yet", "Every session you log builds your training history and weekly totals.");
}

<div class="ht-head">
    <div>
        <h1 class="ht-title">Training journal</h1>
        <p class="ht-lede"><a asp-controller="ClientPlans" asp-action="Index">View assigned workout plans</a></p>
    </div>
    <div class="ht-head-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="icon-plus"></i>Log workout</a>
    </div>
</div>

<partial name="_JournalFilters" model="@((JournalFilterViewModel)ViewData["JournalFilter"]!)" />
@if (Model.Any())
{
    var topActivity = Model.GroupBy(w => w.Activity, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count())
        .First().Key;
    <div class="ht-ledger">
        <div>
            <div class="ht-overline">Sessions</div>
            <div class="value">@Model.Count</div>
        </div>
        <div>
            <div class="ht-overline">Active time</div>
            <div class="value">@((Model.Sum(w => w.DurationMinutes) / 60.0).ToString("0.#"))<small>hours</small></div>
        </div>
        <div>
            <div class="ht-overline">Calories burned</div>
            <div class="value">@Model.Sum(w => w.CaloriesBurned).ToString("N0")<small>kcal</small></div>
        </div>
        <div>
            <div class="ht-overline">Favourite</div>
            <div class="value text">@topActivity</div>
        </div>
    </div>

    <section class="ht-card">
        <ul class="ht-journal client-workout-list">
            @foreach (var workout in Model)
            {
                <li class="ht-entry with-actions">
                    <partial name="_DateBadge" model="workout.LoggedAt" />
                    <div>
                        <div class="title">@workout.Activity</div>
                        <div class="meta">@workout.LoggedAt.ToString("dddd, HH:mm") &middot; @workout.DurationMinutes min</div>
                    </div>
                    <div class="figure">@workout.CaloriesBurned.ToString("N0")<small>kcal</small></div>
                    <div class="ht-row-actions">
                        <a class="btn-icon" asp-action="Create" asp-route-repeatId="@workout.WorkoutLogId" title="Repeat as a new workout" aria-label="Repeat workout"><i class="icon-copy"></i></a>
                        <a class="btn-icon" asp-action="Edit" asp-route-id="@workout.WorkoutLogId" title="Edit" aria-label="Edit workout"><i class="icon-pencil"></i></a>
                        <a class="btn-icon danger" asp-action="Delete" asp-route-id="@workout.WorkoutLogId" title="Delete" aria-label="Delete workout"><i class="icon-trash-2"></i></a>
                    </div>
                </li>
            }
        </ul>
    </section>
}
else
{
    <section class="ht-card">
        @if (((JournalFilterViewModel)ViewData["JournalFilter"]!).HasFilters) { <div class="ht-card-body"><p class="mb-0">No workouts match these filters. Adjust the dates or activity, or clear the filters.</p></div> }
        else { <partial name="_EmptyState" model="emptyState" /> }
    </section>
}
