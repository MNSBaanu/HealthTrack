@model WorkoutLog

<div asp-validation-summary="ModelOnly" class="ht-flash error" role="alert"></div>
<div class="row g-3">
    <div class="col-12">
        <label asp-for="Activity" class="form-label"></label>
        <input asp-for="Activity" class="form-control" list="activitySuggestions" placeholder="e.g. Running" autofocus />
        <datalist id="activitySuggestions">
            <option value="Running"></option>
            <option value="Walking"></option>
            <option value="Cycling"></option>
            <option value="Swimming"></option>
            <option value="Strength training"></option>
            <option value="Yoga"></option>
            <option value="HIIT"></option>
            <option value="Football"></option>
        </datalist>
        <span asp-validation-for="Activity" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DurationMinutes" class="form-label">Duration</label>
        <div class="ht-input-unit">
            <input asp-for="DurationMinutes" class="form-control" placeholder="45" />
            <span class="unit">min</span>
        </div>
        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CaloriesBurned" class="form-label">Calories burned</label>
        <div class="ht-input-unit">
            <input asp-for="CaloriesBurned" class="form-control" placeholder="350" />
            <span class="unit">kcal</span>
        </div>
        <span asp-validation-for="CaloriesBurned" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="LoggedAt" class="form-label">Date &amp; time</label>
        <input asp-for="LoggedAt" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="LoggedAt" class="text-danger"></span>
    </div>
</div>
